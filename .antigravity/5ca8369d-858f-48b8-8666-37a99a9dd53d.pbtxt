          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <BookmarkCheck className=\"h-3.5 w-3.5 text-cyan-400\" />"
