    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  MapPin, \n  Calendar, \n  ExternalLink, \n  Bookmark, \n  BookmarkCheck, \n  Check, \n  AlertTriangle, \n  Info,\n  ChevronDown,\n  ChevronUp,\n  Percent,\n  Banknote\n} from \'lucide-react\';\nimport { EvaluatedOpportunity } from \'../types\';\n\ninterface OpportunityCardProps {\n  opportunity: EvaluatedOpportunity;\n  isSaved: boolean;\n  onToggleSave: (opp: EvaluatedOpportunity) => void;\n  rank?: number;\n}\n\nexport const OpportunityCard: React.FC<OpportunityCardProps> = ({\n  opportunity,\n  isSaved,\n  onToggleSave,\n  rank\n}) => {\n  const [showScoreDetails, setShowScoreDetails] = useState(false);\n\n  const getScoreColor = (score: number) => {\n    if (score >= 85) return \'text-emerald-400 bg-emerald-950/70 border-emerald-800\';\n    if (score >= 70) return \'text-cyan-400 bg-cyan-950/70 border-cyan-800\';\n    return \'text-amber-400 bg-amber-950/70 border-amber-800\';\n  };\n\n  const getSourceBadge = () => {\n    switch (opportunity.source_type) {\n      case \'LIVE_API\':\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800\">\n            Live Verified\n          </span>\n        );\n      case \'CACHED_SOURCE\':\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-950 text-blue-400 border border-blue-800\">\n            Cached\n          </span>\n        );\n      default:\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700\">\n            Curated Dataset\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div \n      id={`opp-card-${opportunity.id}`}\n      className=\"bg-slate-900 border border-slate-800 hover:border-slate-700/90 rounded-2xl p-5 shadow-lg transition-all flex flex-col justify-between\"\n    >\n      <div>\n        {/* Top bar: Rank, Title, Match Score */}\n        <div className=\"flex items-start justify-between gap-3\">\n          <div className=\"flex-1\">\n            <div className=\"flex items-center space-x-2 mb-1.5 flex-wrap gap-y-1\">\n              {rank !== undefined && (\n                <span className=\"text-xs font-mono font-bold px-2 py-0.5 rounded bg-slate-800 text-cyan-400 border border-slate-700\">\n                  #{rank}\n                </span>\n              )}\n              <span className=\"text-xs px-2.5 py-0.5 rounded-full bg-blue-950/80 text-blue-300 border border-blue-800/60 font-medium\">\n                {opportunity.type}\n              </span>\n              {getSourceBadge()}\n              {opportunity.remote && (\n                <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-purple-950/80 text-purple-300 border border-purple-800/60 font-medium\">\n                  Remote / Hybrid\n                </span>\n              )}\n            </div>\n\n            <h3 className=\"text-lg font-bold text-white tracking-tight leading-snug\">\n              {opportunity.title}\n            </h3>\n\n            <div className=\"flex items-center space-x-4 mt-2 text-xs text-slate-400 flex-wrap gap-y-1\">\n              <span className=\"flex items-center font-medium text-slate-300\">\n                <Building2 className=\"h-3.5 w-3.5 mr-1 text-slate-500\" />\n                {opportunity.organization}\n              </span>\n              <span className=\"flex items-center\">\n                <MapPin className=\"h-3.5 w-3.5 mr-1 text-slate-500\" />\n                {opportunity.location}\n              </span>\n              {opportunity.deadline && (\n                <span className=\"flex items-center text-amber-400/90\">\n                  <Calendar className=\"h-3.5 w-3.5 mr-1 text-amber-500\" />\n                  Deadline: {opportunity.deadline}\n                </span>\n              )}\n              {opportunity.stipend_or_salary && (\n                <span className=\"flex items-center text-emerald-400/90\">\n                  <Banknote className=\"h-3.5 w-3.5 mr-1 text-emerald-500\" />\n                  {opportunity.stipend_or_salary}\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* Match Score Badge */}\n          <div className=\"flex flex-col items-end\">\n            <div \n              onClick={() => setShowScoreDetails(!showScoreDetails)}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl border font-bold text-sm cursor-pointer transition-all hover:scale-105 shadow-md ${getScoreColor(opportunity.matchScore)}`}\n              title=\"Click to view transparent 5-factor scoring breakdown\"\n            >\n              <Percent className=\"h-3.5 w-3.5\" />\n              <span>{opportunity.matchScore}% Match</span>\n              {showScoreDetails ? <ChevronUp className=\"h-3 w-3 ml-0.5\" /> : <ChevronDown className=\"h-3 w-3 ml-0.5\" />}\n            </div>\n          </div>\n        </div>\n\n        {/* 5-Factor Scoring Breakdown (Collapsible) */}\n        {showScoreDetails && opportunity.breakdown && (\n          <div className=\"mt-4 p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-xs\">\n            <div className=\"flex items-center justify-between font-semibold text-slate-300 mb-2\">\n              <span>Transparent Fit Scoring Matrix:</span>\n              <span className=\"font-mono text-cyan-400\">{opportunity.matchScore} / 100 pts</span>\n            </div>\n            <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2 text-[11px]\">\n              <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                <span className=\"text-slate-400 block\">Skills (40%)</span>\n                <strong className=\"text-cyan-300 font-mono\">{opportunity.breakdown.skillsScore}/40</strong>\n              </div>\n              <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                <span className=\"text-slate-400 block\">Eligibility (25%)</span>\n                <strong className=\"text-cyan-300 font-mono\">{opportunity.breakdown.eligibilityScore}/25</strong>\n              </div>\n              <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                <span className=\"text-slate-400 block\">Location (15%)</span>\n                <strong className=\"text-cyan-300 font-mono\">{opportunity.breakdown.locationScore}/15</strong>\n              </div>\n              <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                <span className=\"text-slate-400 block\">Type (10%)</span>\n                <strong className=\"text-cyan-300 font-mono\">{opportunity.breakdown.typeScore}/10</strong>\n              </div>\n              <div className=\"p-2 rounded bg-slate-900 border border-slate-800 text-center\">\n                <span className=\"text-slate-400 block\">Year/Exp (10%)</span>\n                <strong className=\"text-cyan-300 font-mono\">{opportunity.breakdown.experienceScore}/10</strong>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Description */}\n        <p className=\"text-xs text-slate-300 mt-3.5 line-clamp-2 leading-relaxed\">\n          {opportunity.description}\n        </p>\n\n        {/* Eligibility Quote */}\n        <div className=\"mt-2.5 p-2 rounded-lg bg-slate-950/60 border border-slate-800/80 text-[11px] text-slate-400 flex items-start space-x-1.5\">\n          <Info className=\"h-3.5 w-3.5 text-slate-500 mt-0.5 shrink-0\" />\n          <span><strong>Eligibility:</strong> {opportunity.eligibility}</span>\n        </div>\n\n        {/* Why Matched Points */}\n        {opportunity.matchReasons && opportunity.matchReasons.length > 0 && (\n          <div className=\"mt-3 space-y-1\">\n            {opportunity.matchReasons.map((reason, idx) => (\n              <div key={idx} className=\"flex items-center text-[11px] text-emerald-400/90 space-x-1.5\">\n                <Check className=\"h-3 w-3 text-emerald-500 shrink-0\" />\n                <span>{reason}</span>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Skills: Matched vs Missing */}\n        <div className=\"mt-4 flex flex-wrap items-center gap-1.5\">\n          {opportunity.matchedSkills?.map((skill, idx) => (\n            <span \n              key={`matched-${idx}`}\n              className=\"text-[11px] px-2 py-0.5 rounded-md bg-emerald-950/60 text-emerald-300 border border-emerald-800/50 flex items-center\"\n            >\n              <Check className=\"h-2.5 w-2.5 mr-1 text-emerald-400\" />\n              {skill}\n            </span>\n          ))}\n          {opportunity.missingSkills?.map((skill, idx) => (\n            <span \n              key={`missing-${idx}`}\n              className=\"text-[11px] px-2 py-0.5 rounded-md bg-amber-950/60 text-amber-300 border border-amber-800/50 flex items-center\"\n            >\n              <span className=\"mr-1 text-[10px]\">\342\226\263</span>\n              {skill} (Gap)\n            </span>\n          ))}\n        </div>\n      </div>\n\n      {/* Bottom bar: Source Transparency & Actions */}\n      <div className=\"mt-5 pt-3.5 border-t border-slate-800 flex items-center justify-between gap-2 text-xs\">\n        <div className=\"text-[11px] text-slate-400 truncate max-w-[200px] sm:max-w-xs\">\n          Source: <span className=\"text-slate-300 font-medium\">{opportunity.source}</span>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          <button\n            onClick={() => onToggleSave(opportunity)}\n            className={`px-3 py-1.5 rounded-lg border text-xs font-semibold flex items-center space-x-1.5 transition-all cursor-pointer ${\n              isSaved\n                ? \'bg-blue-600/20 text-cyan-300 border-cyan-500/50\'\n                : \'bg-slate-800 hover:bg-slate-700 text-slate-300 border-slate-700\'\n            }`}\n          >\n            {isSaved ? (\n              <>\n                <BookmarkCheck className=\"h-3.5 w-3.5 text-cyan-400\" />\n                <span>Saved</span>\n              </>\n            ) : (\n              <>\n                <Bookmark className=\"h-3.5 w-3.5\" />\n                <span>Save</span>\n              </>\n            )}\n          </button>\n\n          {opportunity.url ? (\n            <a\n              href={opportunity.url}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"px-3 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs flex items-center space-x-1 transition-colors cursor-pointer\"\n            >\n              <span>View Source</span>\n              <ExternalLink className=\"h-3 w-3\" />\n            </a>\n          ) : (\n            <span className=\"text-[11px] text-slate-500 italic\">Source URL unavailable</span>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  MapPin, \n  Calendar, \n  ExternalLink, \n  Bookmark, \n  BookmarkCheck, \n  Check, \n  AlertTriangle, \n  Info, \n  ChevronDown, \n  ChevronUp, \n  Percent, \n  Banknote,\n  Sparkles,\n  ShieldCheck\n} from \'lucide-react\';\nimport { EvaluatedOpportunity } from \'../types\';\n\ninterface OpportunityCardProps {\n  opportunity: EvaluatedOpportunity;\n  isSaved: boolean;\n  onToggleSave: (opp: EvaluatedOpportunity) => void;\n  rank?: number;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const OpportunityCard: React.FC<OpportunityCardProps> = ({\n  opportunity,\n  isSaved,\n  onToggleSave,\n  rank,\n  theme = \'dark\'\n}) => {\n  const [showScoreDetails, setShowScoreDetails] = useState(false);\n  const isDark = theme === \'dark\';\n\n  const getScoreColor = (score: number) => {\n    if (score >= 85) {\n      return isDark \n        ? \'text-emerald-300 bg-emerald-950/80 border-emerald-700/80\' \n        : \'text-emerald-800 bg-emerald-50 border-emerald-300\';\n    }\n    if (score >= 70) {\n      return isDark \n        ? \'text-cyan-300 bg-cyan-950/80 border-cyan-700/80\' \n        : \'text-indigo-800 bg-indigo-50 border-indigo-300\';\n    }\n    return isDark \n      ? \'text-amber-300 bg-amber-950/80 border-amber-700/80\' \n      : \'text-amber-800 bg-amber-50 border-amber-300\';\n  };\n\n  const getSourceBadge = () => {\n    switch (opportunity.source_type) {\n      case \'LIVE_API\':\n        return (\n          <span className={`text-[10px] uppercase font-mono font-bold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-emerald-950/90 text-emerald-300 border-emerald-700\' \n              : \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n          }`}>\n            Live Verified\n          </span>\n        );\n      case \'CACHED_SOURCE\':\n        return (\n          <span className={`text-[10px] uppercase font-mono font-bold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-indigo-950/90 text-indigo-300 border-indigo-700\' \n              : \'bg-indigo-50 text-indigo-700 border-indigo-200\'\n          }`}>\n            Verified Cache\n          </span>\n        );\n      default:\n        return (\n          <span className={`text-[10px] uppercase font-mono font-bold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-slate-800 text-slate-300 border-slate-700\' \n              : \'bg-slate-100 text-slate-700 border-slate-200\'\n          }`}>\n            Curated Source\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div \n      id={`opp-card-${opportunity.id}`}\n      className={`rounded-3xl p-5 sm:p-6 border transition-all flex flex-col justify-between hover:scale-[1.01] ${\n        isDark\n          ? \'bg-slate-900/90 border-slate-800 hover:border-slate-700 shadow-xl text-slate-100\'\n          : \'bg-white border-slate-200/90 hover:border-slate-300 shadow-lg text-slate-900\'\n      }`}\n    >\n      <div>\n        {/* Top Header: Rank, Type, Match Score */}\n        <div className=\"flex items-start justify-between gap-3\">\n          <div className=\"flex-1\">\n            <div className=\"flex items-center space-x-2 mb-2 flex-wrap gap-y-1\">\n              {rank !== undefined && (\n                <span className={`text-xs font-mono font-extrabold px-2 py-0.5 rounded-lg border ${\n                  isDark ? \'bg-slate-800 text-cyan-300 border-slate-700\' : \'bg-slate-100 text-indigo-700 border-slate-200\'\n                }`}>\n                  #{rank}\n                </span>\n              )}\n              <span className={`text-xs px-2.5 py-0.5 rounded-full font-bold border ${\n                isDark \n                  ? \'bg-indigo-950/80 text-indigo-300 border-indigo-800/60\' \n                  : \'bg-indigo-50 text-indigo-700 border-indigo-200\'\n              }`}>\n                {opportunity.type}\n              </span>\n              {getSourceBadge()}\n              {opportunity.remote && (\n                <span className={`text-[10px] px-2 py-0.5 rounded-full font-bold border ${\n                  isDark \n                    ? \'bg-purple-950/80 text-purple-300 border-purple-800/60\' \n                    : \'bg-purple-50 text-purple-700 border-purple-200\'\n                }`}>\n                  Remote / Hybrid\n                </span>\n              )}\n            </div>\n\n            <h3 className=\"text-base sm:text-lg font-extrabold tracking-tight leading-snug\">\n              {opportunity.title}\n            </h3>\n\n            <div className={`flex items-center space-x-3.5 mt-2.5 text-xs flex-wrap gap-y-1 ${\n              isDark ? \'text-slate-400\' : \'text-slate-500\'\n            }`}>\n              <span className={`flex items-center font-bold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>\n                <Building2 className=\"h-3.5 w-3.5 mr-1.5 opacity-70\" />\n                {opportunity.organization}\n              </span>\n              <span className=\"flex items-center\">\n                <MapPin className=\"h-3.5 w-3.5 mr-1.5 opacity-70\" />\n                {opportunity.location}\n              </span>\n              {opportunity.deadline && (\n                <span className=\"flex items-center text-amber-600 dark:text-amber-400 font-semibold\">\n                  <Calendar className=\"h-3.5 w-3.5 mr-1.5\" />\n                  Due {opportunity.deadline}\n                </span>\n              )}\n              {opportunity.stipend_or_salary && (\n                <span className=\"flex items-center text-emerald-600 dark:text-emerald-400 font-semibold\">\n                  <Banknote className=\"h-3.5 w-3.5 mr-1.5\" />\n                  {opportunity.stipend_or_salary}\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* Match Score Button / Badge */}\n          <div className=\"flex flex-col items-end shrink-0\">\n            <button \n              onClick={() => setShowScoreDetails(!showScoreDetails)}\n              className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl border font-bold text-xs sm:text-sm cursor-pointer transition-all hover:scale-105 shadow-sm ${getScoreColor(opportunity.matchScore)}`}\n              title=\"Click to view 5-factor scoring details\"\n            >\n              <Percent className=\"h-3.5 w-3.5\" />\n              <span>{opportunity.matchScore}% Match</span>\n              {showScoreDetails ? <ChevronUp className=\"h-3 w-3 ml-0.5\" /> : <ChevronDown className=\"h-3 w-3 ml-0.5\" />}\n            </button>\n          </div>\n        </div>\n\n        {/* 5-Factor Scoring Breakdown */}\n        {showScoreDetails && opportunity.breakdown && (\n          <div className={`mt-4 p-4 rounded-2xl border text-xs ${\n            isDark ? \'bg-slate-950 border-slate-800\' : \'bg-slate-50 border-slate-200\'\n          }`}>\n            <div className=\"flex items-center justify-between font-bold mb-2.5\">\n              <span className=\"flex items-center space-x-1.5\">\n                <ShieldCheck className=\"h-3.5 w-3.5 text-cyan-500\" />\n                <span>5-Factor Deterministic Score:</span>\n              </span>\n              <span className=\"font-mono text-cyan-500 font-extrabold\">{opportunity.matchScore} / 100 pts</span>\n            </div>\n            <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2 text-[11px]\">\n              <div className={`p-2 rounded-xl border text-center ${isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'}`}>\n                <span className={`block ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>Skills (40%)</span>\n                <strong className=\"font-mono text-cyan-500\">{opportunity.breakdown.skillsScore}/40</strong>\n              </div>\n              <div className={`p-2 rounded-xl border text-center ${isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'}`}>\n                <span className={`block ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>Eligibility (25%)</span>\n                <strong className=\"font-mono text-cyan-500\">{opportunity.breakdown.eligibilityScore}/25</strong>\n              </div>\n              <div className={`p-2 rounded-xl border text-center ${isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'}`}>\n                <span className={`block ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>Location (15%)</span>\n                <strong className=\"font-mono text-cyan-500\">{opportunity.breakdown.locationScore}/15</strong>\n              </div>\n              <div className={`p-2 rounded-xl border text-center ${isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'}`}>\n                <span className={`block ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>Type (10%)</span>\n                <strong className=\"font-mono text-cyan-500\">{opportunity.breakdown.typeScore}/10</strong>\n              </div>\n              <div className={`p-2 rounded-xl border text-center ${isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'}`}>\n                <span className={`block ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>Year (10%)</span>\n                <strong className=\"font-mono text-cyan-500\">{opportunity.breakdown.experienceScore}/10</strong>\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Description */}\n        <p className={`text-xs mt-3.5 line-clamp-2 leading-relaxed ${\n          isDark ? \'text-slate-300\' : \'text-slate-600\'\n        }`}>\n          {opportunity.description}\n        </p>\n\n        {/* Eligibility Quote */}\n        <div className={`mt-3 p-2.5 rounded-xl border text-[11px] flex items-start space-x-2 ${\n          isDark ? \'bg-slate-950/60 border-slate-800 text-slate-400\' : \'bg-slate-50 border-slate-200 text-slate-600\'\n        }`}>\n          <Info className=\"h-3.5 w-3.5 text-slate-400 mt-0.5 shrink-0\" />\n          <span><strong>Eligibility:</strong> {opportunity.eligibility}</span>\n        </div>\n\n        {/* Why Matched Points */}\n        {opportunity.matchReasons && opportunity.matchReasons.length > 0 && (\n          <div className=\"mt-3 space-y-1\">\n            {opportunity.matchReasons.map((reason, idx) => (\n              <div key={idx} className=\"flex items-center text-[11px] font-medium text-emerald-600 dark:text-emerald-400 space-x-1.5\">\n                <Check className=\"h-3.5 w-3.5 shrink-0\" />\n                <span>{reason}</span>\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Skills: Matched vs Missing */}\n        <div className=\"mt-4 flex flex-wrap items-center gap-1.5\">\n          {opportunity.matchedSkills?.map((skill, idx) => (\n            <span \n              key={`matched-${idx}`}\n              className={`text-[11px] font-semibold px-2.5 py-0.5 rounded-lg border flex items-center ${\n                isDark\n                  ? \'bg-emerald-950/80 text-emerald-300 border-emerald-700/60\'\n                  : \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n              }`}\n            >\n              <Check className=\"h-3 w-3 mr-1\" />\n              {skill}\n            </span>\n          ))}\n          {opportunity.missingSkills?.map((skill, idx) => (\n            <span \n              key={`missing-${idx}`}\n              className={`text-[11px] font-semibold px-2.5 py-0.5 rounded-lg border flex items-center ${\n                isDark\n                  ? \'bg-amber-950/80 text-amber-300 border-amber-700/60\'\n                  : \'bg-amber-50 text-amber-700 border-amber-200\'\n              }`}\n            >\n              <span className=\"mr-1 text-[10px]\">\342\226\263</span>\n              {skill} (Gap)\n            </span>\n          ))}\n        </div>\n      </div>\n\n      {/* Footer Actions */}\n      <div className={`mt-5 pt-4 border-t flex items-center justify-between gap-2 text-xs ${\n        isDark ? \'border-slate-800\' : \'border-slate-100\'\n      }`}>\n        <div className={`text-[11px] truncate max-w-[180px] sm:max-w-xs ${\n          isDark ? \'text-slate-400\' : \'text-slate-500\'\n        }`}>\n          Source: <span className=\"font-semibold\">{opportunity.source}</span>\n        </div>\n\n        <div className=\"flex items-center space-x-2\">\n          <button\n            onClick={() => onToggleSave(opportunity)}\n            className={`px-3.5 py-2 rounded-xl border text-xs font-bold flex items-center space-x-1.5 transition-all cursor-pointer ${\n              isSaved\n                ? isDark\n                  ? \'bg-indigo-600/30 text-cyan-300 border-cyan-500/60\'\n                  : \'bg-indigo-50 text-indigo-700 border-indigo-300\'\n                : isDark\n                  ? \'bg-slate-800 hover:bg-slate-700 text-slate-300 border-slate-700\'\n                  : \'bg-slate-100 hover:bg-slate-200 text-slate-700 border-slate-200\'\n            }`}\n          >\n            {isSaved ? (\n              <>\n                <BookmarkCheck className=\"h-3.5 w-3.5 text-cyan-400\" />\n                <span>Saved</span>\n              </>\n            ) : (\n              <>\n                <Bookmark className=\"h-3.5 w-3.5\" />\n                <span>Save</span>\n              </>\n            )}\n          </button>\n\n          {opportunity.url ? (\n            <a\n              href={opportunity.url}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className={`px-3.5 py-2 rounded-xl text-white font-bold text-xs flex items-center space-x-1.5 transition-all cursor-pointer ${\n                isDark\n                  ? \'bg-cyan-600 hover:bg-cyan-500 shadow-md shadow-cyan-600/20\'\n                  : \'bg-indigo-600 hover:bg-indigo-700 shadow-md shadow-indigo-600/20\'\n              }`}\n            >\n              <span>Apply</span>\n              <ExternalLink className=\"h-3 w-3\" />\n            </a>\n          ) : (\n            <span className=\"text-[11px] opacity-50 italic\">Internal Post</span>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
