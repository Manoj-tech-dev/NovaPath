    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Sparkles, Briefcase, Target, Flame, Brain, CheckCircle2, ChevronRight, User } from \'lucide-react\';\nimport { UserProfile, EvaluatedOpportunity, SkillGapItem, ActionPlanItem, AgentRun, Memory } from \'../types\';\nimport { GoalInput } from \'../components/GoalInput\';\nimport { AgentExecutionPanel } from \'../components/AgentExecutionPanel\';\nimport { OpportunityCard } from \'../components/OpportunityCard\';\nimport { SkillGapCard } from \'../components/SkillGapCard\';\nimport { ActionPlanView } from \'../components/ActionPlanView\';\n\ninterface DashboardProps {\n  user: UserProfile | null;\n  activeRun: AgentRun | null;\n  isLoading: boolean;\n  onPlanPath: (goal: string) => void;\n  savedOpportunityIds: Set<string>;\n  onToggleSave: (opp: EvaluatedOpportunity) => void;\n  memories: Memory[];\n  onNavigateTab: (tab: \'profile\' | \'opportunities\' | \'plan\' | \'memory\') => void;\n}\n\nexport const Dashboard: React.FC<DashboardProps> = ({\n  user,\n  activeRun,\n  isLoading,\n  onPlanPath,\n  savedOpportunityIds,\n  onToggleSave,\n  memories,\n  onNavigateTab\n}) => {\n  const opportunities = activeRun?.opportunities || [];\n  const skillGaps = activeRun?.skill_gaps || [];\n  const actionPlan = activeRun?.action_plan || [];\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Welcome & Goal Banner */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-2\">\n        <div>\n          <div className=\"flex items-center space-x-2 text-xs font-semibold text-cyan-400 uppercase tracking-wider mb-1\">\n            <Sparkles className=\"h-3.5 w-3.5\" />\n            <span>AI Opportunity Execution Agent</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Welcome back, {user?.name || \'Rahul\'} \360\237\221\213\n          </h1>\n          <p className=\"text-sm text-slate-400 mt-1\">\n            Let\'s turn your career objective into a personalized, step-by-step execution roadmap.\n          </p>\n        </div>\n\n        {/* Quick Profile Summary Badge */}\n        {user && (\n          <div \n            onClick={() => onNavigateTab(\'profile\')}\n            className=\"bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-3 text-xs flex items-center space-x-3 cursor-pointer transition-all self-start md:self-auto\"\n          >\n            <div className=\"p-2 rounded-lg bg-blue-500/10 text-blue-400\">\n              <User className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <span className=\"font-semibold text-slate-200 block\">{user.degree} (Year {user.year}) \342\200\242 {user.branch}</span>\n              <span className=\"text-[11px] text-slate-400\">{user.location} \342\200\242 {user.skills.length} skills \342\200\242 Remote {user.remote_preference ? \'Yes\' : \'No\'}</span>\n            </div>\n            <ChevronRight className=\"h-4 w-4 text-slate-500\" />\n          </div>\n        )}\n      </div>\n\n      {/* Goal Input Section */}\n      <GoalInput \n        onPlanPath={onPlanPath}\n        isLoading={isLoading}\n        activeGoal={activeRun?.goal || \'\'}\n      />\n\n      {/* Agent Execution Stepper Panel */}\n      <AgentExecutionPanel \n        run={activeRun}\n        isLoading={isLoading}\n      />\n\n      {/* Results Section (Appears after or during run) */}\n      {opportunities.length > 0 && (\n        <div className=\"space-y-8\">\n          {/* Top Matches Header */}\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-3\">\n              <div className=\"p-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n                <Briefcase className=\"h-5 w-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-xl font-bold text-white tracking-tight\">\n                  Recommended Opportunities\n                </h2>\n                <p className=\"text-xs text-slate-400\">\n                  Ranked by 5-factor deterministic fit scoring (Skills, Eligibility, Location, Type, Year fit)\n                </p>\n              </div>\n            </div>\n\n            <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700\">\n              {opportunities.length} Matches Found\n            </span>\n          </div>\n\n          {/* Opportunities Cards Grid */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n            {opportunities.map((opp, idx) => (\n              <OpportunityCard\n                key={opp.id}\n                opportunity={opp}\n                isSaved={savedOpportunityIds.has(opp.id)}\n                onToggleSave={onToggleSave}\n                rank={idx + 1}\n              />\n            ))}\n          </div>\n\n          {/* Skill Gap Analysis Section */}\n          <SkillGapCard \n            skillGaps={skillGaps}\n            user={user}\n          />\n\n          {/* Action Plan Section */}\n          {actionPlan.length > 0 && (\n            <ActionPlanView \n              actionPlan={actionPlan}\n            />\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
