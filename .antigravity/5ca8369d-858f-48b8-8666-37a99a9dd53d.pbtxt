    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Sparkles, Briefcase, Target, Flame, Brain, CheckCircle2, ChevronRight, User } from \'lucide-react\';\nimport { UserProfile, EvaluatedOpportunity, SkillGapItem, ActionPlanItem, AgentRun, Memory } from \'../types\';\nimport { GoalInput } from \'../components/GoalInput\';\nimport { AgentExecutionPanel } from \'../components/AgentExecutionPanel\';\nimport { OpportunityCard } from \'../components/OpportunityCard\';\nimport { SkillGapCard } from \'../components/SkillGapCard\';\nimport { ActionPlanView } from \'../components/ActionPlanView\';\n\ninterface DashboardProps {\n  user: UserProfile | null;\n  activeRun: AgentRun | null;\n  isLoading: boolean;\n  onPlanPath: (goal: string) => void;\n  savedOpportunityIds: Set<string>;\n  onToggleSave: (opp: EvaluatedOpportunity) => void;\n  memories: Memory[];\n  onNavigateTab: (tab: \'profile\' | \'opportunities\' | \'plan\' | \'memory\') => void;\n}\n\nexport const Dashboard: React.FC<DashboardProps> = ({\n  user,\n  activeRun,\n  isLoading,\n  onPlanPath,\n  savedOpportunityIds,\n  onToggleSave,\n  memories,\n  onNavigateTab\n}) => {\n  const opportunities = activeRun?.opportunities || [];\n  const skillGaps = activeRun?.skill_gaps || [];\n  const actionPlan = activeRun?.action_plan || [];\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Welcome & Goal Banner */}\n      <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-2\">\n        <div>\n          <div className=\"flex items-center space-x-2 text-xs font-semibold text-cyan-400 uppercase tracking-wider mb-1\">\n            <Sparkles className=\"h-3.5 w-3.5\" />\n            <span>AI Opportunity Execution Agent</span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight\">\n            Welcome back, {user?.name || \'Rahul\'} \360\237\221\213\n          </h1>\n          <p className=\"text-sm text-slate-400 mt-1\">\n            Let\'s turn your career objective into a personalized, step-by-step execution roadmap.\n          </p>\n        </div>\n\n        {/* Quick Profile Summary Badge */}\n        {user && (\n          <div \n            onClick={() => onNavigateTab(\'profile\')}\n            className=\"bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl p-3 text-xs flex items-center space-x-3 cursor-pointer transition-all self-start md:self-auto\"\n          >\n            <div className=\"p-2 rounded-lg bg-blue-500/10 text-blue-400\">\n              <User className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <span className=\"font-semibold text-slate-200 block\">{user.degree} (Year {user.year}) \342\200\242 {user.branch}</span>\n              <span className=\"text-[11px] text-slate-400\">{user.location} \342\200\242 {user.skills.length} skills \342\200\242 Remote {user.remote_preference ? \'Yes\' : \'No\'}</span>\n            </div>\n            <ChevronRight className=\"h-4 w-4 text-slate-500\" />\n          </div>\n        )}\n      </div>\n\n      {/* Goal Input Section */}\n      <GoalInput \n        onPlanPath={onPlanPath}\n        isLoading={isLoading}\n        activeGoal={activeRun?.goal || \'\'}\n      />\n\n      {/* Agent Execution Stepper Panel */}\n      <AgentExecutionPanel \n        run={activeRun}\n        isLoading={isLoading}\n      />\n\n      {/* Results Section (Appears after or during run) */}\n      {opportunities.length > 0 && (\n        <div className=\"space-y-8\">\n          {/* Top Matches Header */}\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center space-x-3\">\n              <div className=\"p-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n                <Briefcase className=\"h-5 w-5\" />\n              </div>\n              <div>\n                <h2 className=\"text-xl font-bold text-white tracking-tight\">\n                  Recommended Opportunities\n                </h2>\n                <p className=\"text-xs text-slate-400\">\n                  Ranked by 5-factor deterministic fit scoring (Skills, Eligibility, Location, Type, Year fit)\n                </p>\n              </div>\n            </div>\n\n            <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700\">\n              {opportunities.length} Matches Found\n            </span>\n          </div>\n\n          {/* Opportunities Cards Grid */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n            {opportunities.map((opp, idx) => (\n              <OpportunityCard\n                key={opp.id}\n                opportunity={opp}\n                isSaved={savedOpportunityIds.has(opp.id)}\n                onToggleSave={onToggleSave}\n                rank={idx + 1}\n              />\n            ))}\n          </div>\n\n          {/* Skill Gap Analysis Section */}\n          <SkillGapCard \n            skillGaps={skillGaps}\n            user={user}\n          />\n\n          {/* Action Plan Section */}\n          {actionPlan.length > 0 && (\n            <ActionPlanView \n              actionPlan={actionPlan}\n            />\n          )}\n        </div>\n      )}\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Sparkles, Briefcase, Target, Flame, Brain, CheckCircle2, ChevronRight, User, Compass, Zap } from \'lucide-react\';\nimport { UserProfile, EvaluatedOpportunity, SkillGapItem, ActionPlanItem, AgentRun, Memory } from \'../types\';\nimport { GoalInput } from \'../components/GoalInput\';\nimport { AgentExecutionPanel } from \'../components/AgentExecutionPanel\';\nimport { OpportunityCard } from \'../components/OpportunityCard\';\nimport { SkillGapCard } from \'../components/SkillGapCard\';\nimport { ActionPlanView } from \'../components/ActionPlanView\';\n\ninterface DashboardProps {\n  user: UserProfile | null;\n  activeRun: AgentRun | null;\n  isLoading: boolean;\n  onPlanPath: (goal: string) => void;\n  savedOpportunityIds: Set<string>;\n  onToggleSave: (opp: EvaluatedOpportunity) => void;\n  memories: Memory[];\n  onNavigateTab: (tab: \'profile\' | \'opportunities\' | \'plan\' | \'memory\') => void;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const Dashboard: React.FC<DashboardProps> = ({\n  user,\n  activeRun,\n  isLoading,\n  onPlanPath,\n  savedOpportunityIds,\n  onToggleSave,\n  memories,\n  onNavigateTab,\n  theme = \'dark\'\n}) => {\n  const opportunities = activeRun?.opportunities || [];\n  const skillGaps = activeRun?.skill_gaps || [];\n  const actionPlan = activeRun?.action_plan || [];\n  const isDark = theme === \'dark\';\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Welcome & Goal Banner */}\n      <div className={`flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-2 border-b ${\n        isDark ? \'border-slate-900\' : \'border-slate-200\'\n      }`}>\n        <div>\n          <div className=\"flex items-center space-x-2 text-xs font-bold uppercase tracking-wider mb-1.5\">\n            <span className={`inline-flex items-center space-x-1.5 px-2.5 py-0.5 rounded-full border font-mono ${\n              isDark ? \'bg-cyan-950/80 text-cyan-300 border-cyan-800/60\' : \'bg-indigo-50 text-indigo-700 border-indigo-200\'\n            }`}>\n              <Sparkles className=\"h-3 w-3\" />\n              <span>Track 01 \342\200\242 Opportunity Execution Agent</span>\n            </span>\n          </div>\n          <h1 className={`text-2xl sm:text-3xl font-extrabold tracking-tight ${\n            isDark ? \'text-white\' : \'text-slate-900\'\n          }`}>\n            Welcome back, {user?.name || \'Rahul\'} \360\237\221\213\n          </h1>\n          <p className={`text-sm mt-1 max-w-2xl ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n            Enter any career aspiration. NovaPath decomposes your goal into verifiable subtasks, computes transparent fit rankings, diagnoses skill gaps, and synthesizes an actionable execution timeline.\n          </p>\n        </div>\n\n        {/* Quick Profile Summary Badge */}\n        {user && (\n          <div \n            id=\"quick-profile-badge\"\n            onClick={() => onNavigateTab(\'profile\')}\n            className={`border rounded-2xl p-4 text-xs flex items-center space-x-3.5 cursor-pointer transition-all self-start md:self-auto shrink-0 ${\n              isDark \n                ? \'bg-slate-900/90 border-slate-800 hover:border-slate-700 text-slate-200 shadow-lg\' \n                : \'bg-white border-slate-200/90 hover:border-slate-300 text-slate-900 shadow-md\'\n            }`}\n          >\n            <div className={`p-2.5 rounded-xl flex items-center justify-center ${\n              isDark ? \'bg-indigo-500/10 text-indigo-400 border border-indigo-500/30\' : \'bg-indigo-50 text-indigo-700 border border-indigo-200\'\n            }`}>\n              <User className=\"h-4 w-4\" />\n            </div>\n            <div>\n              <span className=\"font-bold block\">{user.degree} (Yr {user.year}) \342\200\242 {user.branch}</span>\n              <span className={`text-[11px] font-medium ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                {user.location} \342\200\242 {user.skills.length} skills \342\200\242 Remote {user.remote_preference ? \'Yes\' : \'No\'}\n              </span>\n            </div>\n            <ChevronRight className={`h-4 w-4 ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`} />\n          </div>\n        )}\n      </div>\n\n      {/* Goal Input Section */}\n      <GoalInput \n        onPlanPath={onPlanPath}\n        isLoading={isLoading}\n        activeGoal={activeRun?.goal || \'\'}\n        theme={theme}\n      />\n\n      {/* Agent Execution Stepper Panel */}\n      <AgentExecutionPanel \n        run={activeRun}\n        isLoading={isLoading}\n        theme={theme}\n      />\n\n      {/* Results Section (Appears after or during run) */}\n      {opportunities.length > 0 && (\n        <div className=\"space-y-8\">\n          {/* Top Matches Header */}\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n            <div className=\"flex items-center space-x-3.5\">\n              <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n                isDark ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n              }`}>\n                <Briefcase className=\"h-5 w-5\" />\n              </div>\n              <div>\n                <h2 className={`text-xl font-extrabold tracking-tight ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n                  Ranked Match Opportunities\n                </h2>\n                <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                  Computed via transparent 5-factor scoring model (Skill Overlap 35%, Eligibility 25%, Type 15%, Location 15%, Year 10%)\n                </p>\n              </div>\n            </div>\n\n            <span className={`text-xs font-mono font-bold px-3 py-1 rounded-full border self-start sm:self-auto ${\n              isDark ? \'bg-slate-800 text-slate-300 border-slate-700\' : \'bg-slate-100 text-slate-700 border-slate-200\'\n            }`}>\n              {opportunities.length} Matches Found\n            </span>\n          </div>\n\n          {/* Opportunities Cards Grid */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n            {opportunities.map((opp, idx) => (\n              <OpportunityCard\n                key={opp.id}\n                opportunity={opp}\n                isSaved={savedOpportunityIds.has(opp.id)}\n                onToggleSave={onToggleSave}\n                rank={idx + 1}\n                theme={theme}\n              />\n            ))}\n          </div>\n\n          {/* Skill Gap Analysis Section */}\n          <SkillGapCard \n            skillGaps={skillGaps}\n            user={user}\n            theme={theme}\n          />\n\n          {/* Action Plan Section */}\n          {actionPlan.length > 0 && (\n            <ActionPlanView \n              actionPlan={actionPlan}\n              theme={theme}\n            />\n          )}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
