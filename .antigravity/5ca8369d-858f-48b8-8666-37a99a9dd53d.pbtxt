        }
        lines {
          text: "## 4. Key Features & Track 01 Requirements"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Requirement A: Multi-Step Reasoning & Task Decomposition"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* **10-Step Visible Execution Stepper**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  1. `understand_objective`: Decomposes natural language intent, role, and constraints."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  2. `load_profile`: Fetches student\'s verified degree, branch, year, and skills."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  3. `retrieve_memory`: Recalls long-term preferences, past interactions, and location choices."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  4. `plan_search`: Formulates targeted search criteria."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  5. `search_opportunities`: Queries external/curated opportunity tools."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  6. `evaluate_fit`: Runs transparent 5-factor scoring algorithm."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  7. `identify_skill_gaps`: Calculates missing skills vs. candidate pool requirements."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  8. `rank_opportunities`: Sorts and highlights top matches."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  9. `generate_action_plan`: Builds structured, timeline-based execution checklist."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  10. `update_memory`: Persists newly identified preferences to long-term memory."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Requirement B: External Tool / API Interaction (`OpportunitySearchTool`)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* Standardized `OpportunitySearchTool` abstraction with query filtering across domain, location, remote preference, and eligibility."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* Source provenance badges: **LIVE VERIFIED**, **CACHED**, or **CURATED DATASET**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* Real organizations, deadlines, stipends, and verifiable official portal URLs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Requirement C: Persistent User Memory"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* **Profile Memory**: Stable academic background (e.g., B.Tech 2nd Year, AI/ML, Hyderabad)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* **Interaction & Preference Memory**: Dynamic knowledge retained across sessions."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "* **Demonstrable 2-Session Workflow**:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  * **Session 1**: User states *\"I prefer Hyderabad and remote internships.\"* \342\206\222 Saved to memory."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  * **Session 2**: User enters *\"Find opportunities for me.\"* \342\206\222 NovaPath automatically recalls preferences and searches without requiring manual input."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
