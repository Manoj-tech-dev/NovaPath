  file_change {
    absolute_path_uri: "file:///src/components/AuthModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Zap, \n  Sparkles, \n  ArrowRight, \n  Lock, \n  Mail, \n  User, \n  AlertCircle, \n  Compass, \n  Brain, \n  Briefcase,\n  PlayCircle,\n  ShieldCheck\n} from \'lucide-react\';\nimport { signInWithGoogle, signInWithEmail, signUpWithEmail, signInAsDemoUser } from \'../firebase/auth\';\n\ninterface AuthModalProps {\n  onSuccess: (displayName?: string) => void;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({ onSuccess, theme = \'dark\' }) => {\n  const isDark = theme === \'dark\';\n  const [mode, setMode] = useState<\'login\' | \'signup\'>(\'login\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [displayName, setDisplayName] = useState(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [authError, setAuthError] = useState<{ message: string; isProviderDisabled?: boolean } | null>(null);\n\n  const handleDemoSignIn = async () => {\n    setIsLoading(true);\n    setAuthError(null);\n    try {\n      const user = await signInAsDemoUser(\'Rahul Sharma\', \'rahul.sharma@college.edu\');\n      onSuccess(user.displayName || \'Rahul Sharma\');\n    } catch (err: any) {\n      console.error(\'Demo Sign-In failed:\', err);\n      setAuthError({ message: \'Could not start demo session. Please try again.\' });\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleGoogleSignIn = async () => {\n    setIsLoading(true);\n    setAuthError(null);\n    try {\n      const user = await signInWithGoogle();\n      onSuccess(user.displayName || undefined);\n    } catch (err: any) {\n      console.error(\'Google Sign-In error:\', err);\n      if (err.code === \'auth/operation-not-allowed\' || err.message?.includes(\'operation-not-allowed\')) {\n        setAuthError({\n          message: \'Google Sign-In is not enabled in Firebase Console yet. Click \"Instant Student Access (Demo)\" below to test the full app and Firestore immediately!\',\n          isProviderDisabled: true\n        });\n      } else if (err.code === \'auth/popup-closed-by-user\' || err.code === \'auth/cancelled-popup-request\') {\n        setAuthError({ message: \'Sign-in popup was closed.\' });\n      } else {\n        setAuthError({ message: err.message || \'Google Sign-In failed.\' });\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleEmailSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email.trim() || !password.trim()) {\n      setAuthError({ message: \'Please fill in both email and password.\' });\n      return;\n    }\n    if (password.length < 6) {\n      setAuthError({ message: \'Password must be at least 6 characters.\' });\n      return;\n    }\n\n    setIsLoading(true);\n    setAuthError(null);\n    try {\n      if (mode === \'signup\') {\n        const user = await signUpWithEmail(email, password, displayName || undefined);\n        onSuccess(user.displayName || undefined);\n      } else {\n        const user = await signInWithEmail(email, password);\n        onSuccess(user.displayName || undefined);\n      }\n    } catch (err: any) {\n      console.error(\'Auth error:\', err);\n      if (err.code === \'auth/operation-not-allowed\' || err.message?.includes(\'operation-not-allowed\')) {\n        setAuthError({\n          message: \'Email/Password authentication is not enabled in Firebase Console yet. You can click \"Instant Student Access (Demo)\" below to proceed immediately!\',\n          isProviderDisabled: true\n        });\n      } else if (err.code === \'auth/invalid-credential\' || err.code === \'auth/wrong-password\' || err.code === \'auth/user-not-found\') {\n        setAuthError({ message: \'Invalid email or password.\' });\n      } else if (err.code === \'auth/email-already-in-use\') {\n        setAuthError({ message: \'An account with this email already exists. Try logging in.\' });\n      } else {\n        setAuthError({ message: err.message || \'Authentication failed.\' });\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className={`min-h-screen w-full flex items-center justify-center p-4 sm:p-6 transition-colors ${\n      isDark \n        ? \'bg-slate-950 text-slate-100\' \n        : \'bg-slate-50 text-slate-900\'\n    }`}>\n      {/* Background glow effects */}\n      <div className=\"absolute inset-0 overflow-hidden pointer-events-none\">\n        <div className=\"absolute -top-40 -right-40 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl\" />\n        <div className=\"absolute -bottom-40 -left-40 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl\" />\n      </div>\n\n      <div className=\"w-full max-w-md relative z-10\">\n        {/* Brand Header */}\n        <div className=\"text-center mb-6\">\n          <div className=\"inline-flex items-center justify-center h-14 w-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-cyan-500 text-white shadow-xl shadow-cyan-500/20 mb-3\">\n            <Zap className=\"h-7 w-7 fill-current\" />\n          </div>\n          <h1 className=\"text-2xl font-extrabold tracking-tight\">NovaPath</h1>\n          <p className={`text-xs mt-1 font-medium ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n            Autonomous Opportunity & Career Execution Agent Hub\n          </p>\n          <div className=\"inline-flex items-center space-x-1.5 mt-2 px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-indigo-950/60 border border-indigo-800/60 text-cyan-300\">\n            <Sparkles className=\"w-3 h-3 text-cyan-400\" />\n            <span>LaunchPadX 2026 \342\200\242 Track 01: Agent Hub</span>\n          </div>\n        </div>\n\n        {/* Auth Card */}\n        <div className={`p-6 sm:p-8 rounded-3xl border shadow-2xl backdrop-blur-xl ${\n          isDark \n            ? \'bg-slate-900/90 border-slate-800 shadow-slate-950/80\' \n            : \'bg-white border-slate-200 shadow-xl\'\n        }`}>\n          {/* 1-Click Fast Student Demo Sign-In (Ensures judges & reviewers can test instantly) */}\n          <div className=\"mb-5\">\n            <button\n              id=\"instant-demo-signin-btn\"\n              type=\"button\"\n              onClick={handleDemoSignIn}\n              disabled={isLoading}\n              className={`w-full py-3.5 px-4 rounded-2xl font-bold text-xs flex items-center justify-between transition-all cursor-pointer border ${\n                isDark \n                  ? \'bg-gradient-to-r from-cyan-950/70 via-indigo-950/80 to-slate-900 border-cyan-500/40 text-cyan-200 hover:border-cyan-400 shadow-lg shadow-cyan-950/50\' \n                  : \'bg-gradient-to-r from-cyan-50 to-indigo-50 border-cyan-300 text-indigo-900 hover:border-cyan-400 shadow-sm\'\n              }`}\n            >\n              <div className=\"flex items-center space-x-2.5 text-left\">\n                <div className=\"p-1.5 rounded-xl bg-cyan-500/20 text-cyan-400\">\n                  <PlayCircle className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <div className=\"font-bold flex items-center space-x-1.5\">\n                    <span>Instant Student Demo Mode</span>\n                    <span className=\"text-[9px] font-mono px-1.5 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30\">\n                      B.Tech AI/ML\n                    </span>\n                  </div>\n                  <div className=\"text-[10px] opacity-80\">Test full multi-step agent & Firestore memory</div>\n                </div>\n              </div>\n              <ArrowRight className=\"w-4 h-4 text-cyan-400 shrink-0 ml-2\" />\n            </button>\n          </div>\n\n          <div className=\"relative my-4 flex items-center justify-center\">\n            <div className={`w-full border-t ${isDark ? \'border-slate-800\' : \'border-slate-200\'}`} />\n            <span className={`absolute px-3 text-[10px] uppercase font-mono font-bold tracking-wider ${\n              isDark ? \'bg-slate-900 text-slate-500\' : \'bg-white text-slate-400\'\n            }`}>\n              or sign in with credentials\n            </span>\n          </div>\n\n          {/* Error Alert */}\n          {authError && (\n            <div className={`mb-4 p-3 rounded-2xl border text-xs flex items-start space-x-2 ${\n              authError.isProviderDisabled\n                ? \'bg-amber-950/40 border-amber-800/60 text-amber-200\'\n                : \'bg-rose-950/40 border-rose-800/60 text-rose-300\'\n            }`}>\n              <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n              <div className=\"flex-1\">\n                <div>{authError.message}</div>\n                {authError.isProviderDisabled && (\n                  <button\n                    type=\"button\"\n                    onClick={handleDemoSignIn}\n                    className=\"mt-2 text-[11px] underline font-bold text-cyan-300 hover:text-cyan-200 block cursor-pointer\"\n                  >\n                    \360\237\221\211 Click here to enter as Demo Student (Rahul Sharma)\n                  </button>\n                )}\n              </div>\n            </div>\n          )}\n\n          {/* Google Sign-In */}\n          <button\n            id=\"google-signin-btn\"\n            type=\"button\"\n            onClick={handleGoogleSignIn}\n            disabled={isLoading}\n            className={`w-full py-2.5 px-4 rounded-2xl font-bold text-xs flex items-center justify-center space-x-3 transition-all cursor-pointer border ${\n              isDark \n                ? \'bg-white hover:bg-slate-100 text-slate-900 border-white shadow-md\' \n                : \'bg-white hover:bg-slate-50 text-slate-800 border-slate-300 shadow-sm\'\n            } ${isLoading ? \'opacity-70 cursor-not-allowed\' : \'\'}`}\n          >\n            {/* Google SVG Icon */}\n            <svg className=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\">\n              <path\n                fill=\"#4285F4\"\n                d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n              />\n              <path\n                fill=\"#34A853\"\n                d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n              />\n              <path\n                fill=\"#FBBC05\"\n                d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\"\n              />\n              <path\n                fill=\"#EA4335\"\n                d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\"\n              />\n            </svg>\n            <span>Continue with Google</span>\n          </button>\n\n          {/* Email / Password Form */}\n          <form onSubmit={handleEmailSubmit} className=\"space-y-3 mt-4\">\n            {mode === \'signup\' && (\n              <div>\n                <label className={`block text-[11px] font-bold mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                  Full Name\n                </label>\n                <div className=\"relative\">\n                  <User className={`absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`} />\n                  <input\n                    id=\"signup-fullname-input\"\n                    type=\"text\"\n                    placeholder=\"e.g. Rahul Sharma\"\n                    value={displayName}\n                    onChange={(e) => setDisplayName(e.target.value)}\n                    className={`w-full pl-9 pr-3 py-2 rounded-xl text-xs font-medium border transition-all ${\n                      isDark \n                        ? \'bg-slate-950/80 border-slate-800 text-white placeholder-slate-500 focus:border-cyan-500\' \n                        : \'bg-slate-50 border-slate-200 text-slate-900 placeholder-slate-400 focus:border-indigo-600\'\n                    }`}\n                  />\n                </div>\n              </div>\n            )}\n\n            <div>\n              <label className={`block text-[11px] font-bold mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                Email Address\n              </label>\n              <div className=\"relative\">\n                <Mail className={`absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`} />\n                <input\n                  id=\"auth-email-input\"\n                  type=\"email\"\n                  required\n                  placeholder=\"student@university.edu\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className={`w-full pl-9 pr-3 py-2 rounded-xl text-xs font-medium border transition-all ${\n                    isDark \n                      ? \'bg-slate-950/80 border-slate-800 text-white placeholder-slate-500 focus:border-cyan-500\' \n                      : \'bg-slate-50 border-slate-200 text-slate-900 placeholder-slate-400 focus:border-indigo-600\'\n                  }`}\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className={`block text-[11px] font-bold mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                Password\n              </label>\n              <div className=\"relative\">\n                <Lock className={`absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`} />\n                <input\n                  id=\"auth-password-input\"\n                  type=\"password\"\n                  required\n                  placeholder=\"At least 6 characters\"\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  className={`w-full pl-9 pr-3 py-2 rounded-xl text-xs font-medium border transition-all ${\n                    isDark \n                      ? \'bg-slate-950/80 border-slate-800 text-white placeholder-slate-500 focus:border-cyan-500\' \n                      : \'bg-slate-50 border-slate-200 text-slate-900 placeholder-slate-400 focus:border-indigo-600\'\n                  }`}\n                />\n              </div>\n            </div>\n\n            <button\n              id=\"auth-submit-btn\"\n              type=\"submit\"\n              disabled={isLoading}\n              className={`w-full py-2.5 px-4 rounded-2xl font-bold text-xs flex items-center justify-center space-x-2 transition-all cursor-pointer ${\n                isDark \n                  ? \'bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-500 hover:to-cyan-500 text-white shadow-lg shadow-cyan-500/20\' \n                  : \'bg-indigo-600 hover:bg-indigo-700 text-white shadow-md\'\n              } ${isLoading ? \'opacity-70 cursor-not-allowed\' : \'\'}`}\n            >\n              <span>{isLoading ? \'Processing...\' : (mode === \'signup\' ? \'Create Student Account\' : \'Sign In with Email\')}</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </form>\n\n          {/* Toggle between Login and Signup */}\n          <div className=\"mt-4 text-center\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                setMode(mode === \'login\' ? \'signup\' : \'login\');\n                setAuthError(null);\n              }}\n              className={`text-xs font-semibold hover:underline cursor-pointer ${\n                isDark ? \'text-cyan-400 hover:text-cyan-300\' : \'text-indigo-600 hover:text-indigo-700\'\n              }`}\n            >\n              {mode === \'login\' ? \"Don\'t have an account? Sign up\" : \'Already have an account? Sign in\'}\n            </button>\n          </div>\n        </div>\n\n        {/* Feature Highlights Footer */}\n        <div className=\"mt-6 grid grid-cols-3 gap-2 text-center text-[10px]\">\n          <div className={`p-2.5 rounded-2xl border ${isDark ? \'bg-slate-900/40 border-slate-800/80 text-slate-400\' : \'bg-white border-slate-200 text-slate-600\'}`}>\n            <Compass className=\"w-3.5 h-3.5 mx-auto mb-1 text-cyan-400\" />\n            <span>Autonomous Agent</span>\n          </div>\n          <div className={`p-2.5 rounded-2xl border ${isDark ? \'bg-slate-900/40 border-slate-800/80 text-slate-400\' : \'bg-white border-slate-200 text-slate-600\'}`}>\n            <Brain className=\"w-3.5 h-3.5 mx-auto mb-1 text-indigo-400\" />\n            <span>Cloud Firestore Memory</span>\n          </div>\n          <div className={`p-2.5 rounded-2xl border ${isDark ? \'bg-slate-900/40 border-slate-800/80 text-slate-400\' : \'bg-white border-slate-200 text-slate-600\'}`}>\n            <Briefcase className=\"w-3.5 h-3.5 mx-auto mb-1 text-emerald-400\" />\n            <span>Transparent Scoring</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
