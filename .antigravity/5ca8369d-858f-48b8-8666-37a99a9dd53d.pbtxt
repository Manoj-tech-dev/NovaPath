    replacement_chunks {
      target_content: "import React from \'react\';\nimport { CheckSquare, Flame, Sparkles } from \'lucide-react\';\nimport { ActionPlanItem, AgentRun } from \'../types\';\nimport { ActionPlanView } from \'../components/ActionPlanView\';\n\ninterface PlanPageProps {\n  activeRun: AgentRun | null;\n  onNavigateToDashboard: () => void;\n}\n\nexport const PlanPage: React.FC<PlanPageProps> = ({ activeRun, onNavigateToDashboard }) => {\n  const actionPlan = activeRun?.action_plan || [];\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-6\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between pb-2 border-b border-slate-800\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n            <CheckSquare className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-bold text-white tracking-tight\">\n              Action Plan & Execution Timeline\n            </h1>\n            <p className=\"text-xs text-slate-400\">\n              Concrete milestones decomposed from your latest career objective.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {actionPlan.length > 0 ? (\n        <ActionPlanView actionPlan={actionPlan} />\n      ) : (\n        <div className=\"text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl p-8 space-y-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center mx-auto\">\n            <Flame className=\"h-6 w-6\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-white\">No active plan generated yet</h3>\n          <p className=\"text-xs text-slate-400 max-w-md mx-auto leading-relaxed\">\n            Head over to the Dashboard, enter your target career goal (e.g. <em>\"I want an AI/ML internship in Hyderabad\"</em>), and let NovaPath build your timeline.\n          </p>\n          <button\n            onClick={onNavigateToDashboard}\n            className=\"px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-xs transition-colors\"\n          >\n            Go to Dashboard & Plan My Path\n          </button>\n        </div>\n      )}\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { CheckSquare, Flame, Sparkles, ArrowRight } from \'lucide-react\';\nimport { ActionPlanItem, AgentRun } from \'../types\';\nimport { ActionPlanView } from \'../components/ActionPlanView\';\n\ninterface PlanPageProps {\n  activeRun: AgentRun | null;\n  onNavigateToDashboard: () => void;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const PlanPage: React.FC<PlanPageProps> = ({ \n  activeRun, \n  onNavigateToDashboard,\n  theme = \'dark\'\n}) => {\n  const actionPlan = activeRun?.action_plan || [];\n  const isDark = theme === \'dark\';\n\n  return (\n    <div className=\"max-w-4xl mx-auto space-y-6\">\n      {/* Header */}\n      <div className={`flex items-center justify-between pb-4 border-b ${\n        isDark ? \'border-slate-800\' : \'border-slate-200\'\n      }`}>\n        <div className=\"flex items-center space-x-3.5\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <CheckSquare className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <h1 className={`text-2xl font-extrabold tracking-tight ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n              Action Plan & Execution Timeline\n            </h1>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Concrete milestones decomposed from your latest career objective.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {actionPlan.length > 0 ? (\n        <ActionPlanView actionPlan={actionPlan} theme={theme} />\n      ) : (\n        <div className={`text-center py-16 rounded-3xl border p-8 space-y-4 ${\n          isDark ? \'bg-slate-900/50 border-slate-800 text-slate-300\' : \'bg-slate-50 border-slate-200 text-slate-700\'\n        }`}>\n          <div className={`w-14 h-14 rounded-2xl border flex items-center justify-center mx-auto ${\n            isDark ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Flame className=\"h-7 w-7\" />\n          </div>\n          <h3 className={`text-lg font-extrabold ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n            No active plan generated yet\n          </h3>\n          <p className={`text-xs max-w-md mx-auto leading-relaxed ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n            Head over to the Dashboard, enter your target career goal (e.g. <em>\"I want an AI/ML internship in Hyderabad\"</em>), and let NovaPath build your timeline.\n          </p>\n          <button\n            onClick={onNavigateToDashboard}\n            className={`px-6 py-3 rounded-2xl text-white font-extrabold text-xs transition-all shadow-lg cursor-pointer flex items-center space-x-2 mx-auto ${\n              isDark \n                ? \'bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 shadow-cyan-500/20\' \n                : \'bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-700 hover:to-cyan-700 shadow-indigo-500/20\'\n            }`}\n          >\n            <span>Go to Dashboard & Plan My Path</span>\n            <ArrowRight className=\"h-3.5 w-3.5\" />\n          </button>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
