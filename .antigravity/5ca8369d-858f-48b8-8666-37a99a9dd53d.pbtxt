        target_content: "import { \n  Compass, \n  User, \n  Briefcase, \n  Brain, \n  Bot,\n  Sparkles,\n  Sun,\n  Moon,\n  Zap,\n  HelpCircle,\n  LogOut,\n  FileCheck\n} from \'lucide-react\';\nimport { UserProfile } from \'../types\';\n\ninterface NavbarProps {\n  activeTab: \'dashboard\' | \'profile\' | \'opportunities\' | \'chat\' | \'memory\' | \'ats\';\n  setActiveTab: (tab: \'dashboard\' | \'profile\' | \'opportunities\' | \'chat\' | \'memory\' | \'ats\') => void;\n  user: UserProfile | null;\n  savedCount: number;\n  theme: \'dark\' | \'light\';\n  onToggleTheme: () => void;\n  onOpenGuide?: () => void;\n  onSignOut?: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ \n  activeTab, \n  setActiveTab, \n  user, \n  savedCount,\n  theme,\n  onToggleTheme,\n  onOpenGuide,\n  onSignOut\n}) => {\n  const navItems: Array<{\n    id: \'dashboard\' | \'profile\' | \'opportunities\' | \'chat\' | \'memory\' | \'ats\';\n    label: string;\n    icon: React.ComponentType<{ className?: string }>;\n    badge?: number;\n    isNova?: boolean;\n  }> = [\n    { id: \'dashboard\', label: \'Agent Hub\', icon: Compass },\n    { id: \'chat\', label: \'Agent Nova\', icon: Bot, isNova: true },\n    { id: \'ats\', label: \'ATS Scanner\', icon: FileCheck },\n    { id: \'profile\', label: \'Profile & Skills\', icon: User },\n    { \n      id: \'opportunities\', \n      label: \'Opportunities\', \n      icon: Briefcase,\n      badge: savedCount > 0 ? savedCount : undefined \n    },\n    { id: \'memory\', label: \'Memory Bank\', icon: Brain },\n  ];"
        replacement_content: "import { \n  Compass, \n  User, \n  Briefcase, \n  Brain, \n  Bot,\n  Sparkles,\n  Sun,\n  Moon,\n  Zap,\n  HelpCircle,\n  LogOut,\n  FileCheck,\n  Route\n} from \'lucide-react\';\nimport { UserProfile } from \'../types\';\n\nexport type NavTabType = \'dashboard\' | \'career-path\' | \'profile\' | \'opportunities\' | \'chat\' | \'memory\' | \'ats\';\n\ninterface NavbarProps {\n  activeTab: NavTabType;\n  setActiveTab: (tab: NavTabType) => void;\n  user: UserProfile | null;\n  savedCount: number;\n  theme: \'dark\' | \'light\';\n  onToggleTheme: () => void;\n  onOpenGuide?: () => void;\n  onSignOut?: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ \n  activeTab, \n  setActiveTab, \n  user, \n  savedCount,\n  theme,\n  onToggleTheme,\n  onOpenGuide,\n  onSignOut\n}) => {\n  const navItems: Array<{\n    id: NavTabType;\n    label: string;\n    icon: React.ComponentType<{ className?: string }>;\n    badge?: number;\n    isNova?: boolean;\n    isNew?: boolean;\n  }> = [\n    { id: \'dashboard\', label: \'Agent Hub\', icon: Compass },\n    { id: \'career-path\', label: \'Career Path\', icon: Route, isNew: true },\n    { id: \'chat\', label: \'Agent Nova\', icon: Bot, isNova: true },\n    { id: \'ats\', label: \'ATS Scanner\', icon: FileCheck },\n    { id: \'profile\', label: \'Profile & Skills\', icon: User },\n    { \n      id: \'opportunities\', \n      label: \'Opportunities\', \n      icon: Briefcase,\n      badge: savedCount > 0 ? savedCount : undefined \n    },\n    { id: \'memory\', label: \'Memory Bank\', icon: Brain },\n  ];"
