    replacement_chunks {
      replacement_content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper functions for secure user isolation\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    // User root document and subcollections\n    match /users/{userId} {\n      allow read, write: if isOwner(userId);\n\n      // Student Profile subcollection (users/{userId}/profile/data)\n      match /profile/{document=**} {\n        allow read, write: if isOwner(userId);\n      }\n\n      // Persistent Memory Bank (users/{userId}/memories/{memoryId})\n      match /memories/{memoryId} {\n        allow read, write: if isOwner(userId);\n      }\n\n      // Agent Execution Runs (users/{userId}/agentRuns/{runId})\n      match /agentRuns/{runId} {\n        allow read, write: if isOwner(userId);\n      }\n\n      // Saved Opportunities (users/{userId}/savedOpportunities/{opportunityId})\n      match /savedOpportunities/{opportunityId} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n\n    // Global Opportunities collection (opportunities/{opportunityId})\n    match /opportunities/{opportunityId} {\n      allow read: if isAuthenticated();\n      allow write: if isAuthenticated();\n    }\n  }\n}\n"
