        lines {
          text: "  3. `retrieve_memory`: Recalls long-term preferences, past interactions, and location choices."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "  4. `plan_search`: Formulates targeted search criteria."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
