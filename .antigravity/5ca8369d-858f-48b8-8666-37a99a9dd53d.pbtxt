      target_content: "import React from \'react\';\nimport { \n  GraduationCap, \n  TrendingUp, \n  BookOpen, \n  ExternalLink, \n  Clock, \n  CheckCircle, \n  Layers\n} from \'lucide-react\';\nimport { SkillGapRecommendation } from \'../types\';\n\ninterface SkillGapCardProps {\n  recommendation: SkillGapRecommendation;\n}\n\nexport const SkillGapCard: React.FC<SkillGapCardProps> = ({ recommendation }) => {\n  const getPriorityBadge = (priority: string) => {\n    switch (priority) {\n      case \'HIGH\':\n        return <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-rose-950/80 text-rose-300 border border-rose-800/60\">HIGH PRIORITY GAP</span>;\n      case \'MEDIUM\':\n        return <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 border border-amber-800/60\">MEDIUM PRIORITY</span>;\n      default:\n        return <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-blue-950/80 text-blue-300 border border-blue-800/60\">RECOMMENDED</span>;\n    }\n  };\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\">\n      <div>\n        {/* Header */}\n        <div className=\"flex items-center justify-between mb-3\">\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"text-base font-bold text-white tracking-tight\">\n              {recommendation.skill_name}\n            </span>\n          </div>\n          {getPriorityBadge(recommendation.priority)}\n        </div>\n\n        {/* Why this skill is needed */}\n        <p className=\"text-xs text-slate-300 leading-relaxed mb-3\">\n          {recommendation.reason}\n        </p>\n\n        {/* Estimated Time */}\n        <div className=\"flex items-center space-x-1.5 text-xs text-cyan-400 font-medium mb-3.5\">\n          <Clock className=\"h-3.5 w-3.5\" />\n          <span>Estimated Runway: {recommendation.estimated_hours} Hours</span>\n        </div>\n\n        {/* Recommended Courses / Materials */}\n        <div className=\"space-y-2\">\n          <span className=\"text-[11px] font-semibold uppercase text-slate-400 tracking-wider block\">\n            Recommended Action:\n          </span>\n          {recommendation.courses.map((course, idx) => (\n            <div \n              key={idx}\n              className=\"p-2.5 rounded-xl bg-slate-950/80 border border-slate-800 flex items-center justify-between gap-3 text-xs\"\n            >\n              <div className=\"flex items-center space-x-2\">\n                <BookOpen className=\"h-3.5 w-3.5 text-blue-400 shrink-0\" />\n                <div>\n                  <p className=\"text-slate-200 font-medium\">{course.title}</p>\n                  <p className=\"text-[10px] text-slate-400\">\n                    {course.provider} \342\200\242 {course.type} \342\200\242 {course.estimated_hours}h\n                  </p>\n                </div>\n              </div>\n\n              {course.url && (\n                <a\n                  href={course.url}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"text-cyan-400 hover:text-cyan-300 p-1.5 rounded hover:bg-slate-800 transition-colors flex items-center space-x-1\"\n                >\n                  <span className=\"text-[10px]\">Start</span>\n                  <ExternalLink className=\"h-3 w-3\" />\n                </a>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Associated Opportunities count */}\n      <div className=\"mt-4 pt-3 border-t border-slate-800/80 text-[11px] text-slate-400 flex items-center justify-between\">\n        <span>Required by top matches</span>\n        <span className=\"font-semibold text-slate-300\">Boosts fit by +20%</span>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { \n  GraduationCap, \n  TrendingUp, \n  BookOpen, \n  ExternalLink, \n  Clock, \n  CheckCircle, \n  Layers,\n  Sparkles\n} from \'lucide-react\';\nimport { SkillGapRecommendation } from \'../types\';\n\ninterface SkillGapCardProps {\n  recommendation: SkillGapRecommendation;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const SkillGapCard: React.FC<SkillGapCardProps> = ({ \n  recommendation,\n  theme = \'dark\'\n}) => {\n  const isDark = theme === \'dark\';\n\n  const getPriorityBadge = (priority: string) => {\n    switch (priority) {\n      case \'HIGH\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-rose-950/80 text-rose-300 border-rose-800/60\' \n              : \'bg-rose-50 text-rose-700 border-rose-200\'\n          }`}>\n            High Priority Gap\n          </span>\n        );\n      case \'MEDIUM\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-amber-950/80 text-amber-300 border-amber-800/60\' \n              : \'bg-amber-50 text-amber-700 border-amber-200\'\n          }`}>\n            Medium Priority\n          </span>\n        );\n      default:\n        return (\n          <span className={`text-[10px] font-mono font-extrabold uppercase px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-blue-950/80 text-blue-300 border-blue-800/60\' \n              : \'bg-blue-50 text-blue-700 border-blue-200\'\n          }`}>\n            Elective Skill\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className={`rounded-3xl p-5 sm:p-6 border transition-all flex flex-col justify-between hover:scale-[1.01] ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 hover:border-slate-700 shadow-xl text-slate-100\'\n        : \'bg-white border-slate-200/90 hover:border-slate-300 shadow-lg text-slate-900\'\n    }`}>\n      <div>\n        {/* Header */}\n        <div className=\"flex items-center justify-between mb-3\">\n          <div className=\"flex items-center space-x-2\">\n            <span className={`text-base font-extrabold tracking-tight ${\n              isDark ? \'text-white\' : \'text-slate-900\'\n            }`}>\n              {recommendation.skill_name}\n            </span>\n          </div>\n          {getPriorityBadge(recommendation.priority)}\n        </div>\n\n        {/* Opportunity Context */}\n        <p className={`text-xs leading-relaxed mb-3.5 ${\n          isDark ? \'text-slate-300\' : \'text-slate-600\'\n        }`}>\n          {recommendation.reason}\n        </p>\n\n        {/* Estimated Prep Time */}\n        <div className={`flex items-center space-x-1.5 text-xs font-semibold mb-4 ${\n          isDark ? \'text-cyan-400\' : \'text-indigo-600\'\n        }`}>\n          <Clock className=\"h-3.5 w-3.5\" />\n          <span>Prep Runway: <strong>{recommendation.estimated_hours} Hours</strong> of structured practice</span>\n        </div>\n\n        {/* Recommended Learning Courses / Projects */}\n        <div className=\"space-y-2\">\n          <span className={`text-[11px] font-bold uppercase tracking-wider block ${\n            isDark ? \'text-slate-400\' : \'text-slate-500\'\n          }`}>\n            Recommended Bridge Path:\n          </span>\n          {recommendation.courses.map((course, idx) => (\n            <div \n              key={idx}\n              className={`p-3 rounded-2xl border flex items-center justify-between gap-3 text-xs transition-all ${\n                isDark \n                  ? \'bg-slate-950/70 border-slate-800/80 hover:border-slate-700\' \n                  : \'bg-slate-50 border-slate-200/80 hover:border-slate-300\'\n              }`}\n            >\n              <div className=\"flex items-center space-x-2.5\">\n                <div className={`p-1.5 rounded-xl border ${\n                  isDark ? \'bg-indigo-500/10 border-indigo-500/30 text-indigo-400\' : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n                }`}>\n                  <BookOpen className=\"h-3.5 w-3.5\" />\n                </div>\n                <div>\n                  <p className=\"font-bold\">{course.title}</p>\n                  <p className={`text-[11px] ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                    {course.provider} \342\200\242 {course.type} \342\200\242 {course.estimated_hours}h\n                  </p>\n                </div>\n              </div>\n\n              {course.url && (\n                <a\n                  href={course.url}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className={`p-2 rounded-xl border flex items-center space-x-1 font-bold text-xs transition-colors ${\n                    isDark\n                      ? \'text-cyan-300 hover:text-white bg-slate-900 border-slate-700 hover:bg-slate-800\'\n                      : \'text-indigo-600 hover:text-indigo-800 bg-white border-slate-200 hover:bg-slate-100\'\n                  }`}\n                  title=\"Open Learning Resource\"\n                >\n                  <span className=\"hidden sm:inline\">Start</span>\n                  <ExternalLink className=\"h-3 w-3\" />\n                </a>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Footer advice */}\n      <div className={`mt-5 pt-3.5 border-t text-[11px] flex items-center space-x-1.5 ${\n        isDark ? \'border-slate-800 text-slate-400\' : \'border-slate-100 text-slate-500\'\n      }`}>\n        <Sparkles className=\"h-3 w-3 text-cyan-500 shrink-0\" />\n        <span>Completing these tasks increases match scores across AI/ML opportunities by up to 25%.</span>\n      </div>\n    </div>\n  );\n};\n"
    }
    instruction: "Redesign SkillGapCard with theme support and high visual hierarchy"
  }
}
