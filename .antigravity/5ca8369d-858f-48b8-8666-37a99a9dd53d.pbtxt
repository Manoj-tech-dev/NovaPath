          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "**NovaPath** is a student-first AI opportunity execution agent designed for engineering undergraduates. Rather than acting as a standard conversational chatbot or a passive job search aggregator, NovaPath decomposes a student\'s high-level career goal into structured subtasks, retrieves long-term profile and interaction memory from **Cloud Firestore**, verifies real-time external and curated opportunity data, computes transparent 5-factor fit scores, identifies concrete skill gaps, and generates an executable timeline action plan with Gemini AI."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
