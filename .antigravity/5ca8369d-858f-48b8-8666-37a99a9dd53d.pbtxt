  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export function App() {\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'profile\' | \'opportunities\' | \'plan\' | \'memory\'>(\'dashboard\');\n  const [user, setUser] = useState<UserProfile | null>(INITIAL_USER);\n  const [memories, setMemories] = useState<Memory[]>([]);\n  const [applications, setApplications] = useState<(Application & { opportunity?: any })[]>([]);\n  const [activeRun, setActiveRun] = useState<AgentRun | null>(null);\n  const [agentHistory, setAgentHistory] = useState<AgentRun[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [initialLoaded, setInitialLoaded] = useState(false);\n  const [notification, setNotification] = useState<string | null>(null);\n\n  const showNotification = (msg: string) => {\n    setNotification(msg);\n    setTimeout(() => setNotification(null), 4000);\n  };\n\n  // Initial Data Load\n  const loadData = async () => {\n    try {\n      const [profileData, memoryData, appData, historyData] = await Promise.all([\n        api.getProfile(\'usr_rahul_001\'),\n        api.getMemories(\'usr_rahul_001\'),\n        api.getApplications(\'usr_rahul_001\'),\n        api.getAgentHistory(\'usr_rahul_001\')\n      ]);\n      setUser(profileData);\n      setMemories(memoryData);\n      setApplications(appData);\n      setAgentHistory(historyData);\n\n      if (historyData.length > 0 && !activeRun) {\n        setActiveRun(historyData[0]);\n      }\n    } catch (e) {\n      console.error(\'Error loading initial app data:\', e);\n    } finally {\n      setInitialLoaded(true);\n    }\n  };\n\n  useEffect(() => {\n    loadData();\n  }, []);\n\n  // Run the agent workflow\n  const handlePlanPath = async (goal: string) => {\n    if (!goal.trim() || isLoading) return;\n    setIsLoading(true);\n    try {\n      const result = await api.runAgent(user?.id || \'usr_rahul_001\', goal);\n      setActiveRun(result);\n      \n      // Refresh memories and history after agent execution\n      const [updatedMemories, updatedHistory] = await Promise.all([\n        api.getMemories(user?.id || \'usr_rahul_001\'),\n        api.getAgentHistory(user?.id || \'usr_rahul_001\')\n      ]);\n      setMemories(updatedMemories);\n      setAgentHistory(updatedHistory);\n      \n      showNotification(`Agent execution completed: Found ${result.opportunities?.length || 0} matching opportunities.`);\n    } catch (e: any) {\n      console.error(\'Agent execution error:\', e);\n      showNotification(`Agent error: ${e.message}`);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Demo Preset Trigger\n  const handleSelectPreset = async (preset: \'session-1\' | \'session-2\' | \'reset\') => {\n    setIsLoading(true);\n    try {\n      const res = await api.setDemoPreset(preset);\n      await loadData();\n      showNotification(res.message);\n    } catch (e: any) {\n      console.error(\'Preset error:\', e);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Save / Bookmark Opportunity\n  const handleToggleSave = async (opp: EvaluatedOpportunity) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const isSaved = applications.some(a => a.opportunity_id === opp.id);\n\n    try {\n      if (isSaved) {\n        const app = applications.find(a => a.opportunity_id === opp.id);\n        if (app) {\n          await api.deleteApplication(app.id);\n          setApplications(prev => prev.filter(a => a.id !== app.id));\n          showNotification(`Removed \"${opp.title}\" from saved opportunities.`);\n        }\n      } else {\n        const newApp = await api.saveApplication(userId, opp.id, \'SAVED\');\n        setApplications(prev => [...prev, { ...newApp, opportunity: opp }]);\n        showNotification(`Saved \"${opp.title}\" to My Opportunities!`);\n      }\n    } catch (e: any) {\n      console.error(\'Toggle save error:\', e);\n    }\n  };\n\n  // Update Profile\n  const handleUpdateProfile = async (updatedData: Partial<UserProfile>) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const updated = await api.updateProfile(userId, updatedData);\n    setUser(updated);\n    showNotification(\'Student profile updated successfully.\');\n  };\n\n  // Add Memory\n  const handleAddMemory = async (memData: { memory_type: MemoryType; memory_text: string; importance: MemoryImportance; category: string }) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const newMem = await api.addMemory({\n      user_id: userId,\n      ...memData\n    });\n    setMemories(prev => [newMem, ...prev]);\n    showNotification(\'New preference saved to persistent memory.\');\n  };\n\n  // Delete Memory\n  const handleDeleteMemory = async (id: string) => {\n    await api.deleteMemory(id);\n    setMemories(prev => prev.filter(m => m.id !== id));\n    showNotification(\'Memory node deleted.\');\n  };\n\n  // Update Application Stage\n  const handleUpdateApplicationStatus = async (id: string, opportunityId: string, status: any, notes?: string) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const updated = await api.saveApplication(userId, opportunityId, status, notes);\n    setApplications(prev => prev.map(a => a.id === id ? { ...a, status, notes: notes ?? a.notes } : a));\n    showNotification(`Updated status to ${status}.`);\n  };\n\n  const handleDeleteApplication = async (id: string) => {\n    await api.deleteApplication(id);\n    setApplications(prev => prev.filter(a => a.id !== id));\n    showNotification(\'Opportunity removed from tracker.\');\n  };\n\n  const savedOpportunityIds = new Set(applications.map(a => a.opportunity_id));\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-cyan-500/30 selection:text-cyan-200\">\n      {/* Toast Notification */}\n      {notification && (\n        <div className=\"fixed bottom-5 right-5 z-50 bg-slate-900 border border-cyan-500/50 text-cyan-300 px-4 py-2.5 rounded-xl shadow-2xl text-xs font-semibold flex items-center space-x-2 animate-bounce\">\n          <span>\342\234\250</span>\n          <span>{notification}</span>\n        </div>\n      )}\n\n      {/* Navigation */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        user={user}\n        savedCount={applications.length}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {/* Hackathon Judge Demo Controller */}\n        <DemoController\n          onSelectPreset={handleSelectPreset}\n          onRunGoal={handlePlanPath}\n          isLoading={isLoading}\n        />\n\n        {/* Tab Routing */}\n        {activeTab === \'dashboard\' && (\n          <Dashboard\n            user={user}\n            activeRun={activeRun}\n            isLoading={isLoading}\n            onPlanPath={handlePlanPath}\n            savedOpportunityIds={savedOpportunityIds}\n            onToggleSave={handleToggleSave}\n            memories={memories}\n            onNavigateTab={(tab) => setActiveTab(tab)}\n          />\n        )}\n\n        {activeTab === \'profile\' && (\n          <ProfilePage\n            user={user}\n            onUpdateProfile={handleUpdateProfile}\n          />\n        )}\n\n        {activeTab === \'opportunities\' && (\n          <OpportunitiesPage\n            applications={applications}\n            onUpdateStatus={handleUpdateApplicationStatus}\n            onDeleteApplication={handleDeleteApplication}\n          />\n        )}\n\n        {activeTab === \'plan\' && (\n          <PlanPage\n            activeRun={activeRun}\n            onNavigateToDashboard={() => setActiveTab(\'dashboard\')}\n          />\n        )}\n\n        {activeTab === \'memory\' && (\n          <MemoryPage\n            memories={memories}\n            onAddMemory={handleAddMemory}\n            onDeleteMemory={handleDeleteMemory}\n            agentRuns={agentHistory}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-slate-900 bg-slate-950 py-6 text-center text-xs text-slate-500\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>\n            <strong>NovaPath</strong> \342\200\224 Built for <strong>LaunchPadX 2026</strong> (Track 01: The Agent Hub) by <strong>NovaForge</strong>\n          </span>\n          <span className=\"font-mono text-[11px] text-slate-400\">\n            Multi-step reasoning \342\200\242 Persistent memory \342\200\242 External opportunity tool\n          </span>\n        </div>\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "export function App() {\n  const [activeTab, setActiveTab] = useState<\'dashboard\' | \'profile\' | \'opportunities\' | \'plan\' | \'memory\'>(\'dashboard\');\n  const [theme, setTheme] = useState<\'dark\' | \'light\'>(\'dark\');\n  const [user, setUser] = useState<UserProfile | null>(INITIAL_USER);\n  const [memories, setMemories] = useState<Memory[]>([]);\n  const [applications, setApplications] = useState<(Application & { opportunity?: any })[]>([]);\n  const [activeRun, setActiveRun] = useState<AgentRun | null>(null);\n  const [agentHistory, setAgentHistory] = useState<AgentRun[]>([]);\n  const [isLoading, setIsLoading] = useState(false);\n  const [initialLoaded, setInitialLoaded] = useState(false);\n  const [notification, setNotification] = useState<string | null>(null);\n\n  const toggleTheme = () => {\n    setTheme(prev => (prev === \'dark\' ? \'light\' : \'dark\'));\n  };\n\n  const showNotification = (msg: string) => {\n    setNotification(msg);\n    setTimeout(() => setNotification(null), 4000);\n  };\n\n  // Initial Data Load\n  const loadData = async () => {\n    try {\n      const [profileData, memoryData, appData, historyData] = await Promise.all([\n        api.getProfile(\'usr_rahul_001\'),\n        api.getMemories(\'usr_rahul_001\'),\n        api.getApplications(\'usr_rahul_001\'),\n        api.getAgentHistory(\'usr_rahul_001\')\n      ]);\n      setUser(profileData);\n      setMemories(memoryData);\n      setApplications(appData);\n      setAgentHistory(historyData);\n\n      if (historyData.length > 0 && !activeRun) {\n        setActiveRun(historyData[0]);\n      }\n    } catch (e) {\n      console.error(\'Error loading initial app data:\', e);\n    } finally {\n      setInitialLoaded(true);\n    }\n  };\n\n  useEffect(() => {\n    loadData();\n  }, []);\n\n  // Run the agent workflow\n  const handlePlanPath = async (goal: string) => {\n    if (!goal.trim() || isLoading) return;\n    setIsLoading(true);\n    try {\n      const result = await api.runAgent(user?.id || \'usr_rahul_001\', goal);\n      setActiveRun(result);\n      \n      // Refresh memories and history after agent execution\n      const [updatedMemories, updatedHistory] = await Promise.all([\n        api.getMemories(user?.id || \'usr_rahul_001\'),\n        api.getAgentHistory(user?.id || \'usr_rahul_001\')\n      ]);\n      setMemories(updatedMemories);\n      setAgentHistory(updatedHistory);\n      \n      showNotification(`Agent execution completed: Found ${result.opportunities?.length || 0} matching opportunities.`);\n    } catch (e: any) {\n      console.error(\'Agent execution error:\', e);\n      showNotification(`Agent error: ${e.message}`);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Demo Preset Trigger\n  const handleSelectPreset = async (preset: \'session-1\' | \'session-2\' | \'reset\') => {\n    setIsLoading(true);\n    try {\n      const res = await api.setDemoPreset(preset);\n      await loadData();\n      showNotification(res.message);\n    } catch (e: any) {\n      console.error(\'Preset error:\', e);\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  // Save / Bookmark Opportunity\n  const handleToggleSave = async (opp: EvaluatedOpportunity) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const isSaved = applications.some(a => a.opportunity_id === opp.id);\n\n    try {\n      if (isSaved) {\n        const app = applications.find(a => a.opportunity_id === opp.id);\n        if (app) {\n          await api.deleteApplication(app.id);\n          setApplications(prev => prev.filter(a => a.id !== app.id));\n          showNotification(`Removed \"${opp.title}\" from saved opportunities.`);\n        }\n      } else {\n        const newApp = await api.saveApplication(userId, opp.id, \'SAVED\');\n        setApplications(prev => [...prev, { ...newApp, opportunity: opp }]);\n        showNotification(`Saved \"${opp.title}\" to My Opportunities!`);\n      }\n    } catch (e: any) {\n      console.error(\'Toggle save error:\', e);\n    }\n  };\n\n  // Update Profile\n  const handleUpdateProfile = async (updatedData: Partial<UserProfile>) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const updated = await api.updateProfile(userId, updatedData);\n    setUser(updated);\n    showNotification(\'Student profile updated successfully.\');\n  };\n\n  // Add Memory\n  const handleAddMemory = async (memData: { memory_type: MemoryType; memory_text: string; importance: MemoryImportance; category: string }) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const newMem = await api.addMemory({\n      user_id: userId,\n      ...memData\n    });\n    setMemories(prev => [newMem, ...prev]);\n    showNotification(\'New preference saved to persistent memory.\');\n  };\n\n  // Delete Memory\n  const handleDeleteMemory = async (id: string) => {\n    await api.deleteMemory(id);\n    setMemories(prev => prev.filter(m => m.id !== id));\n    showNotification(\'Memory node deleted.\');\n  };\n\n  // Update Application Stage\n  const handleUpdateApplicationStatus = async (id: string, opportunityId: string, status: any, notes?: string) => {\n    const userId = user?.id || \'usr_rahul_001\';\n    const updated = await api.saveApplication(userId, opportunityId, status, notes);\n    setApplications(prev => prev.map(a => a.id === id ? { ...a, status, notes: notes ?? a.notes } : a));\n    showNotification(`Updated status to ${status}.`);\n  };\n\n  const handleDeleteApplication = async (id: string) => {\n    await api.deleteApplication(id);\n    setApplications(prev => prev.filter(a => a.id !== id));\n    showNotification(\'Opportunity removed from tracker.\');\n  };\n\n  const savedOpportunityIds = new Set(applications.map(a => a.opportunity_id));\n  const isDark = theme === \'dark\';\n\n  return (\n    <div className={`min-h-screen flex flex-col font-sans transition-colors ${\n      isDark \n        ? \'bg-slate-950 text-slate-100 selection:bg-cyan-500/30 selection:text-cyan-200\' \n        : \'bg-slate-50 text-slate-900 selection:bg-indigo-500/30 selection:text-indigo-900\'\n    }`}>\n      {/* Toast Notification */}\n      {notification && (\n        <div className={`fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-2xl shadow-2xl text-xs font-bold flex items-center space-x-2 border animate-bounce ${\n          isDark \n            ? \'bg-slate-900 border-cyan-500/50 text-cyan-300 shadow-cyan-500/10\' \n            : \'bg-white border-indigo-200 text-indigo-700 shadow-indigo-500/15\'\n        }`}>\n          <span>\342\234\250</span>\n          <span>{notification}</span>\n        </div>\n      )}\n\n      {/* Navigation */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        user={user}\n        savedCount={applications.length}\n        theme={theme}\n        onToggleTheme={toggleTheme}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {/* Hackathon Judge Demo Controller */}\n        <DemoController\n          onSelectPreset={handleSelectPreset}\n          onRunGoal={handlePlanPath}\n          isLoading={isLoading}\n          theme={theme}\n        />\n\n        {/* Tab Routing */}\n        {activeTab === \'dashboard\' && (\n          <Dashboard\n            user={user}\n            activeRun={activeRun}\n            isLoading={isLoading}\n            onPlanPath={handlePlanPath}\n            savedOpportunityIds={savedOpportunityIds}\n            onToggleSave={handleToggleSave}\n            memories={memories}\n            onNavigateTab={(tab) => setActiveTab(tab)}\n            theme={theme}\n          />\n        )}\n\n        {activeTab === \'profile\' && (\n          <ProfilePage\n            user={user}\n            onUpdateProfile={handleUpdateProfile}\n            theme={theme}\n          />\n        )}\n\n        {activeTab === \'opportunities\' && (\n          <OpportunitiesPage\n            applications={applications}\n            onUpdateStatus={handleUpdateApplicationStatus}\n            onDeleteApplication={handleDeleteApplication}\n            theme={theme}\n          />\n        )}\n\n        {activeTab === \'plan\' && (\n          <PlanPage\n            activeRun={activeRun}\n            onNavigateToDashboard={() => setActiveTab(\'dashboard\')}\n            theme={theme}\n          />\n        )}\n\n        {activeTab === \'memory\' && (\n          <MemoryPage\n            memories={memories}\n            onAddMemory={handleAddMemory}\n            onDeleteMemory={handleDeleteMemory}\n            agentRuns={agentHistory}\n            theme={theme}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className={`border-t py-6 text-center text-xs transition-colors ${\n        isDark ? \'border-slate-900 bg-slate-950 text-slate-500\' : \'border-slate-200 bg-white text-slate-500\'\n      }`}>\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>\n            <strong className={isDark ? \'text-slate-300\' : \'text-slate-800\'}>NovaPath</strong> \342\200\224 Built for <strong>LaunchPadX 2026</strong> (Track 01: The Agent Hub) by <strong>NovaForge</strong>\n          </span>\n          <span className={`font-mono text-[11px] ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n            Multi-step reasoning \342\200\242 Persistent memory \342\200\242 Transparent scoring\n          </span>\n        </div>\n      </footer>\n    </div>\n  );\n}"
    }
