    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Brain, Plus, Trash2, Tag, Sparkles, CheckCircle2, ShieldCheck, Clock } from \'lucide-react\';\nimport { Memory, MemoryType, MemoryImportance } from \'../types\';\n\ninterface MemoryPanelProps {\n  memories: Memory[];\n  onAddMemory: (memory: { memory_type: MemoryType; memory_text: string; importance: MemoryImportance; category: string }) => void;\n  onDeleteMemory: (id: string) => void;\n}\n\nexport const MemoryPanel: React.FC<MemoryPanelProps> = ({\n  memories,\n  onAddMemory,\n  onDeleteMemory,\n}) => {\n  const [isAdding, setIsAdding] = useState(false);\n  const [newText, setNewText] = useState(\'\');\n  const [newType, setNewType] = useState<MemoryType>(\'PREFERENCE\');\n  const [newImportance, setNewImportance] = useState<MemoryImportance>(\'HIGH\');\n  const [newCategory, setNewCategory] = useState(\'Career Goals\');\n\n  const handleAdd = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newText.trim()) return;\n    onAddMemory({\n      memory_type: newType,\n      memory_text: newText.trim(),\n      importance: newImportance,\n      category: newCategory,\n    });\n    setNewText(\'\');\n    setIsAdding(false);\n  };\n\n  const getImportanceBadge = (importance: MemoryImportance) => {\n    switch (importance) {\n      case \'HIGH\':\n        return <span className=\"text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-rose-950/80 text-rose-400 border border-rose-800/50\">HIGH PRIORITY</span>;\n      case \'MEDIUM\':\n        return <span className=\"text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-amber-950/80 text-amber-400 border border-amber-800/50\">MEDIUM</span>;\n      default:\n        return <span className=\"text-[10px] px-2 py-0.5 rounded font-mono font-bold bg-slate-800 text-slate-400 border border-slate-700\">LOW</span>;\n    }\n  };\n\n  const getTypeBadge = (type: MemoryType) => {\n    switch (type) {\n      case \'PROFILE\':\n        return <span className=\"text-[10px] px-2 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800/60 font-medium\">Profile Anchor</span>;\n      case \'PREFERENCE\':\n        return <span className=\"text-[10px] px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800/60 font-medium\">Active Preference</span>;\n      case \'INTERACTION\':\n        return <span className=\"text-[10px] px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800/60 font-medium\">Session History</span>;\n      default:\n        return <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium\">General</span>;\n    }\n  };\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-800 gap-3\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2 rounded-xl bg-purple-500/10 border border-purple-500/30 text-purple-400\">\n            <Brain className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <h3 className=\"text-base font-bold text-white tracking-tight\">\n                Persistent User Memory Hub\n              </h3>\n              <span className=\"text-xs px-2 py-0.5 rounded-full bg-purple-950 text-purple-300 border border-purple-800\">\n                {memories.length} Active Memories\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              Long-term preferences and session memory automatically recalled across future goals\n            </p>\n          </div>\n        </div>\n\n        <button\n          onClick={() => setIsAdding(!isAdding)}\n          className=\"px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs flex items-center space-x-1.5 transition-colors self-start sm:self-auto cursor-pointer\"\n        >\n          <Plus className=\"h-3.5 w-3.5\" />\n          <span>Add Preference Memory</span>\n        </button>\n      </div>\n\n      {/* Add Memory Modal/Form */}\n      {isAdding && (\n        <form onSubmit={handleAdd} className=\"mt-4 p-4 rounded-xl bg-slate-950 border border-purple-800/40 space-y-3\">\n          <h4 className=\"text-xs font-bold text-purple-300 uppercase tracking-wider\">\n            Teach NovaPath a New Preference\n          </h4>\n          <textarea\n            value={newText}\n            onChange={(e) => setNewText(e.target.value)}\n            placeholder=\"e.g., I want to focus exclusively on Python and Machine Learning roles in Hyderabad with hybrid flexibility.\"\n            rows={2}\n            className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-purple-500\"\n          />\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n            <div>\n              <label className=\"text-[11px] text-slate-400 block mb-1\">Memory Type</label>\n              <select\n                value={newType}\n                onChange={(e) => setNewType(e.target.value as MemoryType)}\n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-xs text-slate-200\"\n              >\n                <option value=\"PREFERENCE\">Preference</option>\n                <option value=\"PROFILE\">Profile Anchor</option>\n                <option value=\"INTERACTION\">Interaction History</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"text-[11px] text-slate-400 block mb-1\">Importance</label>\n              <select\n                value={newImportance}\n                onChange={(e) => setNewImportance(e.target.value as MemoryImportance)}\n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-xs text-slate-200\"\n              >\n                <option value=\"HIGH\">High Priority</option>\n                <option value=\"MEDIUM\">Medium</option>\n                <option value=\"LOW\">Low</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"text-[11px] text-slate-400 block mb-1\">Category</label>\n              <input\n                type=\"text\"\n                value={newCategory}\n                onChange={(e) => setNewCategory(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-700 rounded-lg p-1.5 text-xs text-slate-200\"\n                placeholder=\"Category\"\n              />\n            </div>\n          </div>\n          <div className=\"flex justify-end space-x-2 pt-2\">\n            <button\n              type=\"button\"\n              onClick={() => setIsAdding(false)}\n              className=\"px-3 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-3 py-1 rounded bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs\"\n            >\n              Save Memory\n            </button>\n          </div>\n        </form>\n      )}\n\n      {/* Memory Cards Grid */}\n      <div className=\"mt-5 grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n        {memories.map((m) => (\n          <div\n            key={m.id}\n            id={`mem-card-${m.id}`}\n            className=\"p-4 rounded-xl bg-slate-950/80 border border-slate-800/90 hover:border-slate-700 transition-colors flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"flex items-center justify-between gap-2 mb-2\">\n                <div className=\"flex items-center space-x-2\">\n                  {getTypeBadge(m.memory_type)}\n                  {getImportanceBadge(m.importance)}\n                </div>\n                <button\n                  onClick={() => onDeleteMemory(m.id)}\n                  className=\"text-slate-500 hover:text-rose-400 p-1 rounded transition-colors\"\n                  title=\"Delete memory\"\n                >\n                  <Trash2 className=\"h-3.5 w-3.5\" />\n                </button>\n              </div>\n\n              <p className=\"text-xs text-slate-200 leading-relaxed font-normal\">\n                \"{m.memory_text}\"\n              </p>\n            </div>\n\n            <div className=\"mt-3 pt-2.5 border-t border-slate-900 flex items-center justify-between text-[10px] text-slate-500\">\n              <span className=\"flex items-center\">\n                <Tag className=\"h-3 w-3 mr-1 text-purple-400/80\" />\n                {m.category || \'General\'}\n              </span>\n              <span className=\"flex items-center\">\n                <Clock className=\"h-3 w-3 mr-1 text-slate-600\" />\n                {new Date(m.created_at).toLocaleDateString()}\n              </span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Memory System Guarantee Footer */}\n      <div className=\"mt-5 p-3.5 rounded-xl bg-slate-950/50 border border-slate-800 text-xs text-slate-400 flex items-center space-x-2\">\n        <ShieldCheck className=\"h-4 w-4 text-emerald-400 shrink-0\" />\n        <span>\n          <strong>Stateful Guarantee:</strong> In Session 2, running <em>\"Find opportunities for me\"</em> automatically leverages these exact memory nodes without needing you to re-type preferences.\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    }
