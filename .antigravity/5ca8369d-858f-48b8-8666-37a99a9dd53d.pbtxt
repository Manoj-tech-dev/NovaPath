    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { GoogleGenAI } from \'@google/genai\';\n\nlet geminiClient: GoogleGenAI | null = null;\n\nexport function getGeminiClient(): GoogleGenAI | null {\n  if (!geminiClient && process.env.GEMINI_API_KEY) {\n    geminiClient = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n  }\n  return geminiClient;\n}\n\nexport interface ParsedGoal {\n  roleOrDomain: string;\n  preferredLocation?: string;\n  opportunityType?: string;\n  remotePreferred?: boolean;\n  targetSkills: string[];\n  extractedPreferences: string[];\n  intentSummary: string;\n}\n\nexport async function parseGoalWithAI(goalText: string, userProfileSummary: string, memorySummary: string): Promise<ParsedGoal> {\n  const ai = getGeminiClient();\n  if (ai) {\n    try {\n      const prompt = `You are the Goal Analyzer module in NovaPath, an AI Opportunity Execution Agent for engineering students.\nAnalyze the student\'s career goal in the context of their profile and saved memory.\n\nStudent Profile Context:\n${userProfileSummary}\n\nStudent Memory Context:\n${memorySummary}\n\nUser\'s Input Goal:\n\"${goalText}\"\n\nReturn a valid JSON object matching this schema:\n{\n  \"roleOrDomain\": \"string (e.g. AI/ML, Frontend, Data Science)\",\n  \"preferredLocation\": \"string or null (e.g. Hyderabad, Bengaluru, Remote)\",\n  \"opportunityType\": \"string or null (e.g. Internship, Research, Full-time)\",\n  \"remotePreferred\": boolean or null,\n  \"targetSkills\": [\"skill1\", \"skill2\"],\n  \"extractedPreferences\": [\"specific preference 1\", \"specific preference 2\"],\n  \"intentSummary\": \"1-2 sentence crisp breakdown of what the student wants to achieve\"\n}`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.7-flash\',\n        contents: prompt,\n        config: {\n          responseMimeType: \'application/json\',\n        },\n      });\n\n      if (response.text) {\n        return JSON.parse(response.text.trim()) as ParsedGoal;\n      }\n    } catch (e) {\n      console.warn(\'Gemini goal parsing error, falling back to deterministic parser:\', e);\n    }\n  }\n\n  // Deterministic fallback rule-engine\n  const textLower = goalText.toLowerCase();\n  const isAIML = textLower.includes(\'ai\') || textLower.includes(\'ml\') || textLower.includes(\'machine learning\') || textLower.includes(\'deep learning\');\n  const isFrontend = textLower.includes(\'frontend\') || textLower.includes(\'react\') || textLower.includes(\'web\');\n  const isData = textLower.includes(\'data\') || textLower.includes(\'analytics\');\n  \n  let roleOrDomain = \'Software Engineering\';\n  if (isAIML) roleOrDomain = \'AI/ML\';\n  else if (isFrontend) roleOrDomain = \'Frontend Engineering\';\n  else if (isData) roleOrDomain = \'Data Science & Analytics\';\n\n  const isHyd = textLower.includes(\'hyderabad\') || textLower.includes(\'hyd\');\n  const isBlr = textLower.includes(\'bengaluru\') || textLower.includes(\'bangalore\');\n  const isRemote = textLower.includes(\'remote\') || textLower.includes(\'work from home\') || textLower.includes(\'wfh\');\n\n  const preferredLocation = isHyd ? \'Hyderabad\' : (isBlr ? \'Bengaluru\' : undefined);\n  const opportunityType = textLower.includes(\'research\') ? \'Research\' : \'Internship\';\n\n  const extractedPreferences: string[] = [];\n  if (preferredLocation) extractedPreferences.push(`Target location: ${preferredLocation}`);\n  if (isRemote) extractedPreferences.push(\'Prefers remote or hybrid options\');\n  if (roleOrDomain) extractedPreferences.push(`Target domain: ${roleOrDomain}`);\n\n  return {\n    roleOrDomain,\n    preferredLocation,\n    opportunityType,\n    remotePreferred: isRemote || undefined,\n    targetSkills: isAIML ? [\'Python\', \'Machine Learning\', \'SQL\'] : [\'JavaScript\', \'React\', \'Node.js\'],\n    extractedPreferences,\n    intentSummary: `Targeting ${opportunityType} roles in ${roleOrDomain}${preferredLocation ? ` located in ${preferredLocation}` : \'\'}.`\n  };\n}\n"
    }
