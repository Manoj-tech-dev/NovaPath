        target_content: "  const handleDemoSignIn = async () => {\n    setIsLoading(true);\n    setAuthError(null);\n    try {\n      const user = await signInAsDemoUser(\'Rahul Sharma\', \'rahul.sharma@college.edu\');\n      onSuccess(user);\n    } catch (err: any) {\n      console.error(\'Demo Sign-In failed:\', err);\n      setAuthError(\'Could not start demo session. Please try again.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleGoogleSignIn = async () => {\n    setIsLoading(true);\n    setAuthError(null);\n    try {\n      const user = await signInWithGoogle();\n      onSuccess(user);\n    } catch (err: any) {\n      console.error(\'Google Sign-In error:\', err);\n      if (err.code === \'auth/popup-closed-by-user\' || err.code === \'auth/cancelled-popup-request\') {\n        setAuthError(\'Google sign-in popup was cancelled.\');\n      } else {\n        const fallbackUser = await signInAsDemoUser(\'Rahul Sharma\', \'student.novapath@google.com\');\n        onSuccess(fallbackUser);\n      }\n    } finally {\n      setIsLoading(false);\n    }\n  };"
