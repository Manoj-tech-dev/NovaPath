    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Target, Clock, Code, ArrowUpRight, CheckCircle2, AlertTriangle } from \'lucide-react\';\nimport { SkillGapItem, UserProfile } from \'../types\';\n\ninterface SkillGapCardProps {\n  skillGaps: SkillGapItem[];\n  user: UserProfile | null;\n}\n\nexport const SkillGapCard: React.FC<SkillGapCardProps> = ({ skillGaps, user }) => {\n  const getPriorityBadge = (priority: SkillGapItem[\'priority\']) => {\n    switch (priority) {\n      case \'CRITICAL\':\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-rose-950/80 text-rose-400 border border-rose-800/60\">\n            High Priority Gap\n          </span>\n        );\n      case \'RECOMMENDED\':\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-amber-950/80 text-amber-400 border border-amber-800/60\">\n            Recommended\n          </span>\n        );\n      default:\n        return (\n          <span className=\"text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-blue-950/80 text-blue-400 border border-blue-800/60\">\n            Bonus / Nice-to-have\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      <div className=\"flex items-center justify-between pb-4 border-b border-slate-800\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400\">\n            <Target className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-base font-bold text-white tracking-tight\">\n              Skill-Gap & Upskilling Roadmap\n            </h3>\n            <p className=\"text-xs text-slate-400\">\n              Targeted skill bridge based on requirements of your highest-match opportunities\n            </p>\n          </div>\n        </div>\n\n        {skillGaps.length > 0 && (\n          <span className=\"text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700\">\n            {skillGaps.length} Actionable Gaps\n          </span>\n        )}\n      </div>\n\n      {/* User\'s Verified Skill Baseline */}\n      {user && (\n        <div className=\"mt-4 p-3.5 rounded-xl bg-slate-950/60 border border-slate-800/80\">\n          <div className=\"flex items-center space-x-2 text-xs font-semibold text-slate-300 mb-2\">\n            <CheckCircle2 className=\"h-3.5 w-3.5 text-emerald-400\" />\n            <span>Your Verified Skill Inventory ({user.skills.length} skills):</span>\n          </div>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {user.skills.map((skill, idx) => (\n              <span \n                key={idx}\n                className=\"text-xs px-2.5 py-0.5 rounded-md bg-emerald-950/40 text-emerald-300 border border-emerald-800/40 font-medium\"\n              >\n                \342\234\223 {skill}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Actionable Gaps List */}\n      <div className=\"mt-5 space-y-3.5\">\n        {skillGaps.length > 0 ? (\n          skillGaps.map((gap, idx) => (\n            <div \n              key={idx}\n              className=\"p-4 rounded-xl bg-slate-950/80 border border-slate-800/90 hover:border-slate-700 transition-colors\"\n            >\n              <div className=\"flex items-start justify-between gap-3\">\n                <div>\n                  <div className=\"flex items-center space-x-2\">\n                    <span className=\"text-sm font-bold text-white tracking-tight\">\n                      \342\226\263 {gap.skill}\n                    </span>\n                    {getPriorityBadge(gap.priority)}\n                  </div>\n                  <p className=\"text-xs text-slate-300 mt-1 leading-relaxed\">\n                    {gap.suggestedAction}\n                  </p>\n                </div>\n\n                <div className=\"text-right shrink-0\">\n                  <span className=\"inline-flex items-center text-[11px] font-medium text-amber-400 bg-amber-950/50 px-2 py-0.5 rounded border border-amber-900/50\">\n                    <Clock className=\"h-3 w-3 mr-1\" />\n                    {gap.estimatedTimeToLearn}\n                  </span>\n                </div>\n              </div>\n\n              {/* Sample Mini Project */}\n              <div className=\"mt-3 pt-2.5 border-t border-slate-800/80 flex items-start space-x-2 text-xs text-slate-400\">\n                <Code className=\"h-3.5 w-3.5 text-cyan-400 mt-0.5 shrink-0\" />\n                <span>\n                  <strong className=\"text-slate-300\">Suggested Hands-On Project:</strong> {gap.sampleMiniProject}\n                </span>\n              </div>\n            </div>\n          ))\n        ) : (\n          <div className=\"text-center py-6 text-slate-400 text-xs\">\n            <CheckCircle2 className=\"h-8 w-8 text-emerald-400 mx-auto mb-2 opacity-80\" />\n            <p>No critical skill gaps found. Your profile matches 100% of the core competencies for top opportunities!</p>\n          </div>\n        )}\n      </div>\n\n      <div className=\"mt-4 p-3 rounded-xl bg-slate-950/40 border border-slate-800/60 text-[11px] text-slate-400 flex items-center justify-between\">\n        <span>* Skill gaps are prioritized by frequency across matching roles.</span>\n        <span className=\"text-cyan-400 font-medium cursor-pointer\">Learn More \342\206\222</span>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Target, Clock, Code, ArrowUpRight, CheckCircle2, AlertTriangle, Sparkles } from \'lucide-react\';\nimport { SkillGapItem, UserProfile } from \'../types\';\n\ninterface SkillGapCardProps {\n  skillGaps: SkillGapItem[];\n  user: UserProfile | null;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const SkillGapCard: React.FC<SkillGapCardProps> = ({ \n  skillGaps, \n  user,\n  theme = \'dark\'\n}) => {\n  const isDark = theme === \'dark\';\n\n  const getPriorityBadge = (priority: SkillGapItem[\'priority\']) => {\n    switch (priority) {\n      case \'CRITICAL\':\n        return (\n          <span className={`text-[10px] uppercase font-mono font-extrabold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-rose-950/80 text-rose-300 border-rose-800/60\' \n              : \'bg-rose-50 text-rose-700 border-rose-200\'\n          }`}>\n            High Priority Gap\n          </span>\n        );\n      case \'RECOMMENDED\':\n        return (\n          <span className={`text-[10px] uppercase font-mono font-extrabold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-amber-950/80 text-amber-300 border-amber-800/60\' \n              : \'bg-amber-50 text-amber-700 border-amber-200\'\n          }`}>\n            Recommended\n          </span>\n        );\n      default:\n        return (\n          <span className={`text-[10px] uppercase font-mono font-extrabold tracking-wider px-2 py-0.5 rounded-full border ${\n            isDark \n              ? \'bg-blue-950/80 text-blue-300 border-blue-800/60\' \n              : \'bg-indigo-50 text-indigo-700 border-indigo-200\'\n          }`}>\n            Elective Skill\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className={`rounded-3xl p-6 sm:p-7 border transition-all ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 shadow-2xl text-slate-100\'\n        : \'bg-white border-slate-200/90 shadow-xl text-slate-900\'\n    }`}>\n      {/* Header */}\n      <div className={`flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b gap-3 ${\n        isDark ? \'border-slate-800\' : \'border-slate-100\'\n      }`}>\n        <div className=\"flex items-center space-x-3.5\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-amber-500/10 border-amber-500/30 text-amber-400\' \n              : \'bg-amber-50 border-amber-200 text-amber-600\'\n          }`}>\n            <Target className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-base sm:text-lg font-extrabold tracking-tight\">\n              Skill-Gap & Upskilling Roadmap\n            </h3>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Targeted skill bridge based on requirements of your highest-match opportunities\n            </p>\n          </div>\n        </div>\n\n        {skillGaps.length > 0 && (\n          <span className={`text-xs font-mono font-bold px-3 py-1 rounded-full border self-start sm:self-auto ${\n            isDark ? \'bg-slate-800 text-slate-300 border-slate-700\' : \'bg-slate-100 text-slate-700 border-slate-200\'\n          }`}>\n            {skillGaps.length} Actionable Gaps\n          </span>\n        )}\n      </div>\n\n      {/* User\'s Verified Skill Baseline */}\n      {user && (\n        <div className={`mt-5 p-4 rounded-2xl border ${\n          isDark ? \'bg-slate-950/60 border-slate-800/80\' : \'bg-slate-50 border-slate-200/80\'\n        }`}>\n          <div className=\"flex items-center space-x-2 text-xs font-bold mb-2\">\n            <CheckCircle2 className=\"h-4 w-4 text-emerald-500\" />\n            <span>Your Verified Skill Inventory ({user.skills.length} skills):</span>\n          </div>\n          <div className=\"flex flex-wrap gap-1.5\">\n            {user.skills.map((skill, idx) => (\n              <span \n                key={idx}\n                className={`text-xs font-semibold px-2.5 py-1 rounded-lg border ${\n                  isDark \n                    ? \'bg-emerald-950/50 text-emerald-300 border-emerald-800/50\' \n                    : \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                }`}\n              >\n                \342\234\223 {skill}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Actionable Gaps List */}\n      <div className=\"mt-5 space-y-3.5\">\n        {skillGaps.length > 0 ? (\n          skillGaps.map((gap, idx) => (\n            <div \n              key={idx}\n              className={`p-4 sm:p-5 rounded-2xl border transition-all ${\n                isDark \n                  ? \'bg-slate-950/80 border-slate-800/90 hover:border-slate-700\' \n                  : \'bg-slate-50/90 border-slate-200/90 hover:border-slate-300\'\n              }`}\n            >\n              <div className=\"flex flex-col sm:flex-row sm:items-start justify-between gap-2.5\">\n                <div>\n                  <div className=\"flex items-center space-x-2 flex-wrap gap-y-1\">\n                    <span className=\"text-sm font-extrabold tracking-tight\">\n                      \342\226\263 {gap.skill}\n                    </span>\n                    {getPriorityBadge(gap.priority)}\n                  </div>\n                  <p className={`text-xs mt-1.5 leading-relaxed ${\n                    isDark ? \'text-slate-300\' : \'text-slate-600\'\n                  }`}>\n                    {gap.suggestedAction}\n                  </p>\n                </div>\n\n                <div className=\"self-start sm:self-auto shrink-0\">\n                  <span className={`inline-flex items-center text-[11px] font-bold px-2.5 py-1 rounded-xl border ${\n                    isDark\n                      ? \'text-amber-300 bg-amber-950/60 border-amber-800/60\'\n                      : \'text-amber-800 bg-amber-50 border-amber-200\'\n                  }`}>\n                    <Clock className=\"h-3 w-3 mr-1\" />\n                    {gap.estimatedTimeToLearn}\n                  </span>\n                </div>\n              </div>\n\n              {/* Sample Mini Project */}\n              <div className={`mt-3.5 pt-3 border-t flex items-start space-x-2 text-xs ${\n                isDark ? \'border-slate-800/80 text-slate-400\' : \'border-slate-200 text-slate-600\'\n              }`}>\n                <Code className=\"h-3.5 w-3.5 text-cyan-500 mt-0.5 shrink-0\" />\n                <span>\n                  <strong className={isDark ? \'text-slate-200\' : \'text-slate-800\'}>Suggested Hands-On Project:</strong> {gap.sampleMiniProject}\n                </span>\n              </div>\n            </div>\n          ))\n        ) : (\n          <div className={`text-center py-8 rounded-2xl border text-xs ${\n            isDark ? \'border-slate-800 text-slate-400\' : \'border-slate-200 text-slate-500\'\n          }`}>\n            <CheckCircle2 className=\"h-8 w-8 text-emerald-500 mx-auto mb-2 opacity-80\" />\n            <p className=\"font-semibold\">No critical skill gaps found!</p>\n            <p className=\"mt-1\">Your profile matches all primary competencies required for top-ranked roles.</p>\n          </div>\n        )}\n      </div>\n\n      <div className={`mt-5 p-3.5 rounded-2xl border text-[11px] flex items-center justify-between ${\n        isDark ? \'bg-slate-950/40 border-slate-800/60 text-slate-400\' : \'bg-slate-50 border-slate-200 text-slate-600\'\n      }`}>\n        <span>* Skill gaps are prioritized dynamically by frequency across matching opportunities.</span>\n        <span className={`font-semibold flex items-center ${isDark ? \'text-cyan-400\' : \'text-indigo-600\'}`}>\n          <Sparkles className=\"h-3 w-3 mr-1\" />\n          Bridge Pathway Active\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    }
