    instruction: "Update OpportunitiesPage with theme support and high contrast styling"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { Briefcase, ExternalLink, Trash2, Building2, MapPin, Calendar, CheckCircle2, Bookmark, Clock, Banknote } from \'lucide-react\';\nimport { Application, ApplicationStatus } from \'../types\';\n\ninterface OpportunitiesPageProps {\n  applications: (Application & { opportunity?: any })[];\n  onUpdateStatus: (id: string, opportunityId: string, status: ApplicationStatus, notes?: string) => Promise<void>;\n  onDeleteApplication: (id: string) => Promise<void>;\n}\n\nexport const OpportunitiesPage: React.FC<OpportunitiesPageProps> = ({\n  applications,\n  onUpdateStatus,\n  onDeleteApplication,\n}) => {\n  const [filterStatus, setFilterStatus] = useState<string>(\'ALL\');\n\n  const filtered = applications.filter(app => {\n    if (filterStatus === \'ALL\') return true;\n    return app.status === filterStatus;\n  });\n\n  const getStatusBadge = (status: ApplicationStatus) => {\n    switch (status) {\n      case \'APPLIED\':\n        return <span className=\"text-[10px] font-bold px-2.5 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800\">APPLIED</span>;\n      case \'INTERVIEWING\':\n        return <span className=\"text-[10px] font-bold px-2.5 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800\">INTERVIEWING</span>;\n      case \'OFFER\':\n        return <span className=\"text-[10px] font-bold px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800\">OFFER RECEIVED</span>;\n      case \'REJECTED\':\n        return <span className=\"text-[10px] font-bold px-2.5 py-0.5 rounded bg-rose-950 text-rose-400 border border-rose-800\">ARCHIVED</span>;\n      default:\n        return <span className=\"text-[10px] font-bold px-2.5 py-0.5 rounded bg-slate-800 text-cyan-300 border border-slate-700\">SAVED</span>;\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-800 gap-3\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n            <Briefcase className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-bold text-white tracking-tight\">\n              My Saved & Applied Opportunities\n            </h1>\n            <p className=\"text-xs text-slate-400\">\n              Track submission status, official source portals, and interview milestones in one place.\n            </p>\n          </div>\n        </div>\n\n        {/* Filter Pills */}\n        <div className=\"flex flex-wrap items-center gap-1.5 self-start sm:self-auto\">\n          {[\'ALL\', \'SAVED\', \'APPLIED\', \'INTERVIEWING\', \'OFFER\'].map(status => (\n            <button\n              key={status}\n              onClick={() => setFilterStatus(status)}\n              className={`px-3 py-1 rounded-lg text-xs font-semibold border transition-all ${\n                filterStatus === status\n                  ? \'bg-cyan-950 text-cyan-300 border-cyan-500/60\'\n                  : \'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200\'\n              }`}\n            >\n              {status} {status === \'ALL\' && `(${applications.length})`}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Applications */}\n      {filtered.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filtered.map(app => {\n            const opp = app.opportunity;\n            if (!opp) return null;\n\n            return (\n              <div\n                key={app.id}\n                className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between gap-2 mb-2\">\n                    <span className=\"text-xs px-2 py-0.5 rounded-full bg-blue-950/80 text-blue-300 border border-blue-800/50 font-medium\">\n                      {opp.type}\n                    </span>\n                    {getStatusBadge(app.status)}\n                  </div>\n\n                  <h3 className=\"text-base font-bold text-white tracking-tight\">\n                    {opp.title}\n                  </h3>\n\n                  <div className=\"mt-2 space-y-1 text-xs text-slate-400\">\n                    <div className=\"flex items-center text-slate-300 font-medium\">\n                      <Building2 className=\"h-3.5 w-3.5 mr-1.5 text-slate-500\" />\n                      {opp.organization}\n                    </div>\n                    <div className=\"flex items-center\">\n                      <MapPin className=\"h-3.5 w-3.5 mr-1.5 text-slate-500\" />\n                      {opp.location} {opp.remote && \'(Remote / Hybrid)\'}\n                    </div>\n                    {opp.deadline && (\n                      <div className=\"flex items-center text-amber-400\">\n                        <Calendar className=\"h-3.5 w-3.5 mr-1.5 text-amber-500\" />\n                        Deadline: {opp.deadline}\n                      </div>\n                    )}\n                    {opp.stipend_or_salary && (\n                      <div className=\"flex items-center text-emerald-400\">\n                        <Banknote className=\"h-3.5 w-3.5 mr-1.5 text-emerald-500\" />\n                        {opp.stipend_or_salary}\n                      </div>\n                    )}\n                  </div>\n\n                  {/* Skills */}\n                  <div className=\"mt-3 flex flex-wrap gap-1\">\n                    {opp.skills?.slice(0, 4).map((skill: string, idx: number) => (\n                      <span key={idx} className=\"text-[10px] px-2 py-0.5 rounded bg-slate-950 text-slate-300 border border-slate-800\">\n                        {skill}\n                      </span>\n                    ))}\n                  </div>\n\n                  {/* Status Dropdown */}\n                  <div className=\"mt-4 pt-3 border-t border-slate-800\">\n                    <label className=\"text-[11px] font-semibold text-slate-400 block mb-1\">\n                      Update Application Stage:\n                    </label>\n                    <select\n                      value={app.status}\n                      onChange={e => onUpdateStatus(app.id, opp.id, e.target.value as ApplicationStatus)}\n                      className=\"w-full bg-slate-950 border border-slate-700 rounded-lg p-1.5 text-xs text-slate-200\"\n                    >\n                      <option value=\"SAVED\">Saved / Exploring</option>\n                      <option value=\"APPLIED\">Applied / Submitted</option>\n                      <option value=\"INTERVIEWING\">Interviewing Stage</option>\n                      <option value=\"OFFER\">Offer Extended</option>\n                      <option value=\"REJECTED\">Archived / Closed</option>\n                    </select>\n                  </div>\n                </div>\n\n                {/* Card Footer */}\n                <div className=\"mt-4 pt-3 border-t border-slate-800 flex items-center justify-between text-xs\">\n                  {opp.url ? (\n                    <a\n                      href={opp.url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"text-cyan-400 hover:text-cyan-300 font-semibold flex items-center space-x-1\"\n                    >\n                      <span>Official Portal</span>\n                      <ExternalLink className=\"h-3 w-3\" />\n                    </a>\n                  ) : (\n                    <span className=\"text-[11px] text-slate-500\">Source: {opp.source}</span>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteApplication(app.id)}\n                    className=\"text-slate-500 hover:text-rose-400 transition-colors p-1\"\n                    title=\"Remove from tracker\"\n                  >\n                    <Trash2 className=\"h-3.5 w-3.5\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      ) : (\n        <div className=\"text-center py-12 bg-slate-900 border border-slate-800 rounded-2xl p-8\">\n          <Bookmark className=\"h-10 w-10 text-slate-600 mx-auto mb-3\" />\n          <h3 className=\"text-base font-bold text-white\">No opportunities in this category yet</h3>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-sm mx-auto\">\n            Explore opportunities on your Dashboard or run an agent search to bookmark matches.\n          </p>\n        </div>\n      )}\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { Briefcase, ExternalLink, Trash2, Building2, MapPin, Calendar, CheckCircle2, Bookmark, Clock, Banknote, Sparkles } from \'lucide-react\';\nimport { Application, ApplicationStatus } from \'../types\';\n\ninterface OpportunitiesPageProps {\n  applications: (Application & { opportunity?: any })[];\n  onUpdateStatus: (id: string, opportunityId: string, status: ApplicationStatus, notes?: string) => Promise<void>;\n  onDeleteApplication: (id: string) => Promise<void>;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const OpportunitiesPage: React.FC<OpportunitiesPageProps> = ({\n  applications,\n  onUpdateStatus,\n  onDeleteApplication,\n  theme = \'dark\'\n}) => {\n  const [filterStatus, setFilterStatus] = useState<string>(\'ALL\');\n  const isDark = theme === \'dark\';\n\n  const filtered = applications.filter(app => {\n    if (filterStatus === \'ALL\') return true;\n    return app.status === filterStatus;\n  });\n\n  const getStatusBadge = (status: ApplicationStatus) => {\n    switch (status) {\n      case \'APPLIED\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full border ${\n            isDark ? \'bg-blue-950/80 text-blue-300 border-blue-800\' : \'bg-blue-50 text-blue-700 border-blue-200\'\n          }`}>\n            APPLIED\n          </span>\n        );\n      case \'INTERVIEWING\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full border ${\n            isDark ? \'bg-purple-950/80 text-purple-300 border-purple-800\' : \'bg-purple-50 text-purple-700 border-purple-200\'\n          }`}>\n            INTERVIEWING\n          </span>\n        );\n      case \'OFFER\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full border ${\n            isDark ? \'bg-emerald-950/80 text-emerald-300 border-emerald-800\' : \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n          }`}>\n            OFFER EXTENDED\n          </span>\n        );\n      case \'REJECTED\':\n        return (\n          <span className={`text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full border ${\n            isDark ? \'bg-rose-950/80 text-rose-300 border-rose-800\' : \'bg-rose-50 text-rose-700 border-rose-200\'\n          }`}>\n            ARCHIVED\n          </span>\n        );\n      default:\n        return (\n          <span className={`text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full border ${\n            isDark ? \'bg-slate-800 text-cyan-300 border-slate-700\' : \'bg-slate-100 text-indigo-700 border-slate-200\'\n          }`}>\n            SAVED\n          </span>\n        );\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className={`flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b gap-3 ${\n        isDark ? \'border-slate-800\' : \'border-slate-200\'\n      }`}>\n        <div className=\"flex items-center space-x-3.5\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Briefcase className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <h1 className={`text-2xl font-extrabold tracking-tight ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n              Saved & Applied Opportunities\n            </h1>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Track submission status, official source portals, and interview milestones in one place.\n            </p>\n          </div>\n        </div>\n\n        {/* Filter Pills */}\n        <div className=\"flex flex-wrap items-center gap-1.5 self-start sm:self-auto\">\n          {[\'ALL\', \'SAVED\', \'APPLIED\', \'INTERVIEWING\', \'OFFER\'].map(status => (\n            <button\n              key={status}\n              onClick={() => setFilterStatus(status)}\n              className={`px-3.5 py-1.5 rounded-xl text-xs font-bold border transition-all cursor-pointer ${\n                filterStatus === status\n                  ? isDark\n                    ? \'bg-cyan-950/80 text-cyan-300 border-cyan-500/60 shadow-sm\'\n                    : \'bg-indigo-600 text-white border-indigo-600 shadow-sm\'\n                  : isDark\n                    ? \'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200\'\n                    : \'bg-slate-50 text-slate-600 border-slate-200 hover:text-slate-900\'\n              }`}\n            >\n              {status} {status === \'ALL\' && `(${applications.length})`}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Grid of Applications */}\n      {filtered.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filtered.map(app => {\n            const opp = app.opportunity;\n            if (!opp) return null;\n\n            return (\n              <div\n                key={app.id}\n                className={`rounded-3xl p-6 border transition-all flex flex-col justify-between ${\n                  isDark\n                    ? \'bg-slate-900/90 border-slate-800 shadow-xl text-slate-100\'\n                    : \'bg-white border-slate-200/90 shadow-lg text-slate-900\'\n                }`}\n              >\n                <div>\n                  <div className=\"flex items-center justify-between gap-2 mb-2.5\">\n                    <span className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${\n                      isDark ? \'bg-blue-950/80 text-blue-300 border-blue-800/50\' : \'bg-blue-50 text-blue-700 border-blue-200\'\n                    }`}>\n                      {opp.type}\n                    </span>\n                    {getStatusBadge(app.status)}\n                  </div>\n\n                  <h3 className=\"text-base font-extrabold tracking-tight\">\n                    {opp.title}\n                  </h3>\n\n                  <div className=\"mt-2.5 space-y-1.5 text-xs\">\n                    <div className={`flex items-center font-bold ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                      <Building2 className=\"h-3.5 w-3.5 mr-1.5 text-indigo-500\" />\n                      {opp.organization}\n                    </div>\n                    <div className={`flex items-center ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                      <MapPin className=\"h-3.5 w-3.5 mr-1.5 text-slate-400\" />\n                      {opp.location} {opp.remote && \'(Remote / Hybrid)\'}\n                    </div>\n                    {opp.deadline && (\n                      <div className=\"flex items-center text-amber-500 font-medium\">\n                        <Calendar className=\"h-3.5 w-3.5 mr-1.5\" />\n                        Deadline: {opp.deadline}\n                      </div>\n                    )}\n                    {opp.stipend_or_salary && (\n                      <div className=\"flex items-center text-emerald-500 font-bold\">\n                        <Banknote className=\"h-3.5 w-3.5 mr-1.5\" />\n                        {opp.stipend_or_salary}\n                      </div>\n                    )}\n                  </div>\n\n                  {/* Skills */}\n                  <div className=\"mt-3.5 flex flex-wrap gap-1.5\">\n                    {opp.skills?.slice(0, 4).map((skill: string, idx: number) => (\n                      <span \n                        key={idx} \n                        className={`text-[10px] font-semibold px-2.5 py-1 rounded-lg border ${\n                          isDark ? \'bg-slate-950 text-slate-300 border-slate-800\' : \'bg-slate-50 text-slate-700 border-slate-200\'\n                        }`}\n                      >\n                        {skill}\n                      </span>\n                    ))}\n                  </div>\n\n                  {/* Status Dropdown */}\n                  <div className={`mt-4 pt-3.5 border-t ${isDark ? \'border-slate-800\' : \'border-slate-100\'}`}>\n                    <label className={`text-[11px] font-bold block mb-1.5 ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n                      Update Pipeline Stage:\n                    </label>\n                    <select\n                      value={app.status}\n                      onChange={e => onUpdateStatus(app.id, opp.id, e.target.value as ApplicationStatus)}\n                      className={`w-full rounded-xl p-2 text-xs font-semibold border ${\n                        isDark ? \'bg-slate-950 border-slate-700 text-slate-200\' : \'bg-white border-slate-300 text-slate-800\'\n                      }`}\n                    >\n                      <option value=\"SAVED\">Saved / Exploring</option>\n                      <option value=\"APPLIED\">Applied / Submitted</option>\n                      <option value=\"INTERVIEWING\">Interviewing Stage</option>\n                      <option value=\"OFFER\">Offer Extended</option>\n                      <option value=\"REJECTED\">Archived / Closed</option>\n                    </select>\n                  </div>\n                </div>\n\n                {/* Card Footer */}\n                <div className={`mt-4 pt-3.5 border-t flex items-center justify-between text-xs ${\n                  isDark ? \'border-slate-800\' : \'border-slate-100\'\n                }`}>\n                  {opp.url ? (\n                    <a\n                      href={opp.url}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className={`font-bold flex items-center space-x-1 hover:underline ${\n                        isDark ? \'text-cyan-400 hover:text-cyan-300\' : \'text-indigo-600 hover:text-indigo-700\'\n                      }`}\n                    >\n                      <span>Official Portal</span>\n                      <ExternalLink className=\"h-3 w-3\" />\n                    </a>\n                  ) : (\n                    <span className={`text-[11px] ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`}>Source: {opp.source}</span>\n                  )}\n\n                  <button\n                    onClick={() => onDeleteApplication(app.id)}\n                    className={`p-1.5 rounded-lg transition-colors cursor-pointer ${\n                      isDark ? \'text-slate-500 hover:text-rose-400 hover:bg-slate-850\' : \'text-slate-400 hover:text-rose-600 hover:bg-slate-100\'\n                    }`}\n                    title=\"Remove from tracker\"\n                  >\n                    <Trash2 className=\"h-4 w-4\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      ) : (\n        <div className={`text-center py-16 rounded-3xl border p-8 ${\n          isDark ? \'bg-slate-900/50 border-slate-800 text-slate-400\' : \'bg-slate-50 border-slate-200 text-slate-600\'\n        }`}>\n          <Bookmark className=\"h-10 w-10 text-slate-400 mx-auto mb-3 opacity-60\" />\n          <h3 className={`text-base font-bold ${isDark ? \'text-white\' : \'text-slate-900\'}`}>No opportunities in this category yet</h3>\n          <p className=\"text-xs mt-1 max-w-sm mx-auto\">\n            Explore opportunities on your Dashboard or run an agent search to bookmark matches.\n          </p>\n        </div>\n      )}\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
