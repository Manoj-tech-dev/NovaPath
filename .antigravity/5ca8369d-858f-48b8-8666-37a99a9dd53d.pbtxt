        lines {
          text: "## 8. Hackathon Judge Demo Walkthrough"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Scenario 1: First Session (Specify Preferences)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. In the top **LaunchPadX 2026 Judge Quick-Demo** banner, click **`Session 1: \"AI/ML in Hyderabad\"`**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "2. Observe the **10-Step Execution Panel** step-by-step progress."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "3. Review the ranked opportunities, match breakdown (e.g. CognitiveScale, Microsoft R&D, Swiggy Tech Labs), identified skill gaps (TensorFlow, Docker), and the action plan."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "4. Note that NovaPath saves the preference for *Hyderabad* and *AI/ML* to memory."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "### Scenario 2: Second Session (Memory Recall)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "1. Click **`Session 2: \"Find for me\" (Memory Recall)`**."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
