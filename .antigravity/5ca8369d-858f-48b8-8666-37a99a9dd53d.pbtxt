  file_change {
    absolute_path_uri: "file:///src/components/DemoController.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Sparkles, RotateCcw, ArrowRight, Play, CheckCircle2 } from \'lucide-react\';\n\ninterface DemoControllerProps {\n  onSelectPreset: (preset: \'session-1\' | \'session-2\' | \'reset\') => void;\n  onRunGoal: (goal: string) => void;\n  isLoading: boolean;\n}\n\nexport const DemoController: React.FC<DemoControllerProps> = ({\n  onSelectPreset,\n  onRunGoal,\n  isLoading,\n}) => {\n  return (\n    <div className=\"bg-slate-900/95 border border-cyan-900/40 rounded-xl p-3.5 shadow-xl backdrop-blur-md mb-6\">\n      <div className=\"flex flex-col md:flex-row items-start md:items-center justify-between gap-3\">\n        {/* Left side: Judge Info */}\n        <div className=\"flex items-center space-x-2.5\">\n          <div className=\"p-1.5 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n            <Sparkles className=\"h-4 w-4\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className=\"text-xs font-bold text-cyan-300 uppercase tracking-wider\">\n                LaunchPadX 2026 \342\200\242 Judge Quick-Demo\n              </span>\n              <span className=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700\">\n                Track 01 Verification\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              Run 2-session persistent memory flow or test decomposed agent orchestration\n            </p>\n          </div>\n        </div>\n\n        {/* Right side: Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2 w-full md:w-auto\">\n          <button\n            id=\"demo-session-1-btn\"\n            disabled={isLoading}\n            onClick={() => {\n              onSelectPreset(\'session-1\');\n              onRunGoal(\'I want an AI/ML internship in Hyderabad.\');\n            }}\n            className=\"flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-950 text-cyan-300 border border-cyan-700/50 hover:bg-cyan-900/60 transition-all disabled:opacity-50\"\n            title=\"Demonstrates Session 1: Expresses specific location and domain preferences, which NovaPath saves to persistent memory.\"\n          >\n            <Play className=\"h-3.5 w-3.5 text-cyan-400\" />\n            <span>Session 1: \"AI/ML in Hyderabad\"</span>\n          </button>\n\n          <button\n            id=\"demo-session-2-btn\"\n            disabled={isLoading}\n            onClick={() => {\n              onSelectPreset(\'session-2\');\n              onRunGoal(\'Find opportunities for me.\');\n            }}\n            className=\"flex-1 sm:flex-none flex items-center justify-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-950 text-blue-300 border border-blue-700/50 hover:bg-blue-900/60 transition-all disabled:opacity-50\"\n            title=\"Demonstrates Session 2: Prompts generic \'Find opportunities for me\' and NovaPath automatically recalls saved preferences from memory.\"\n          >\n            <CheckCircle2 className=\"h-3.5 w-3.5 text-blue-400\" />\n            <span>Session 2: \"Find for me\" (Memory Recall)</span>\n          </button>\n\n          <button\n            id=\"demo-reset-btn\"\n            disabled={isLoading}\n            onClick={() => onSelectPreset(\'reset\')}\n            className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition-colors disabled:opacity-50\"\n            title=\"Reset Database & Profile to Rahul Sharma Defaults\"\n          >\n            <RotateCcw className=\"h-3.5 w-3.5\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Visual Pipeline Bar */}\n      <div className=\"mt-3 pt-2.5 border-t border-slate-800/80 flex items-center justify-between overflow-x-auto text-[11px] text-slate-400 font-mono gap-2\">\n        <span className=\"text-slate-300 font-semibold flex items-center\">\n          GOAL\n          <ArrowRight className=\"h-3 w-3 mx-1 text-slate-600 inline\" />\n        </span>\n        <span className=\"text-cyan-400 font-medium\">\n          MULTI-STEP REASONING\n          <ArrowRight className=\"h-3 w-3 mx-1 text-slate-600 inline\" />\n        </span>\n        <span className=\"text-purple-400 font-medium\">\n          PERSISTENT MEMORY\n          <ArrowRight className=\"h-3 w-3 mx-1 text-slate-600 inline\" />\n        </span>\n        <span className=\"text-amber-400 font-medium\">\n          EXTERNAL SEARCH TOOL\n          <ArrowRight className=\"h-3 w-3 mx-1 text-slate-600 inline\" />\n        </span>\n        <span className=\"text-emerald-400 font-medium\">\n          5-FACTOR EVALUATION\n          <ArrowRight className=\"h-3 w-3 mx-1 text-slate-600 inline\" />\n        </span>\n        <span className=\"text-blue-400 font-semibold\">\n          ACTION PLAN\n        </span>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Sparkles, RotateCcw, ArrowRight, Play, CheckCircle2, ShieldAlert } from \'lucide-react\';\n\ninterface DemoControllerProps {\n  onSelectPreset: (preset: \'session-1\' | \'session-2\' | \'reset\') => void;\n  onRunGoal: (goal: string) => void;\n  isLoading: boolean;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const DemoController: React.FC<DemoControllerProps> = ({\n  onSelectPreset,\n  onRunGoal,\n  isLoading,\n  theme = \'dark\'\n}) => {\n  const isDark = theme === \'dark\';\n\n  return (\n    <div className={`rounded-2xl p-4 sm:p-5 border transition-all mb-6 ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 shadow-xl text-slate-100\'\n        : \'bg-white border-slate-200/90 shadow-md text-slate-900\'\n    }`}>\n      <div className=\"flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4\">\n        {/* Left side: Judge Info */}\n        <div className=\"flex items-center space-x-3\">\n          <div className={`p-2.5 rounded-xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Sparkles className=\"h-4 w-4\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <span className={`text-xs font-extrabold uppercase tracking-wider ${\n                isDark ? \'text-cyan-300\' : \'text-indigo-700\'\n              }`}>\n                Track 01 Verification Controller\n              </span>\n              <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${\n                isDark \n                  ? \'bg-slate-800 text-slate-300 border-slate-700\' \n                  : \'bg-slate-100 text-slate-700 border-slate-200\'\n              }`}>\n                2-Session Flow\n              </span>\n            </div>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Trigger multi-step agent reasoning, tool execution, and stateful memory recall tests with one click.\n            </p>\n          </div>\n        </div>\n\n        {/* Right side: Action Buttons */}\n        <div className=\"flex flex-wrap items-center gap-2.5 w-full lg:w-auto\">\n          <button\n            id=\"demo-session-1-btn\"\n            disabled={isLoading}\n            onClick={() => {\n              onSelectPreset(\'session-1\');\n              onRunGoal(\'I want an AI/ML internship in Hyderabad.\');\n            }}\n            className={`flex-1 sm:flex-none flex items-center justify-center space-x-2 px-3.5 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer disabled:opacity-50 ${\n              isDark\n                ? \'bg-cyan-950/80 text-cyan-300 border-cyan-700/60 hover:bg-cyan-900/80 hover:border-cyan-500\'\n                : \'bg-indigo-50 text-indigo-700 border-indigo-300 hover:bg-indigo-100 hover:border-indigo-400\'\n            }`}\n            title=\"Session 1: Establishes domain & location preferences in persistent memory.\"\n          >\n            <Play className=\"h-3.5 w-3.5 fill-current\" />\n            <span>Session 1: \"AI/ML in Hyderabad\"</span>\n          </button>\n\n          <button\n            id=\"demo-session-2-btn\"\n            disabled={isLoading}\n            onClick={() => {\n              onSelectPreset(\'session-2\');\n              onRunGoal(\'Find opportunities for me.\');\n            }}\n            className={`flex-1 sm:flex-none flex items-center justify-center space-x-2 px-3.5 py-2 rounded-xl text-xs font-bold border transition-all cursor-pointer disabled:opacity-50 ${\n              isDark\n                ? \'bg-purple-950/80 text-purple-300 border-purple-700/60 hover:bg-purple-900/80 hover:border-purple-500\'\n                : \'bg-purple-50 text-purple-700 border-purple-300 hover:bg-purple-100 hover:border-purple-400\'\n            }`}\n            title=\"Session 2: Generic prompt that automatically pulls saved context from Memory.\"\n          >\n            <CheckCircle2 className=\"h-3.5 w-3.5\" />\n            <span>Session 2: Recall Memory</span>\n          </button>\n\n          <button\n            id=\"demo-reset-btn\"\n            disabled={isLoading}\n            onClick={() => onSelectPreset(\'reset\')}\n            className={`p-2 rounded-xl border transition-all cursor-pointer disabled:opacity-50 ${\n              isDark\n                ? \'text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700 border-slate-700\'\n                : \'text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border-slate-200\'\n            }`}\n            title=\"Reset database to initial state\"\n          >\n            <RotateCcw className=\"h-4 w-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Visual Pipeline Stages */}\n      <div className={`mt-3.5 pt-3 border-t flex items-center justify-between overflow-x-auto text-[11px] font-mono gap-2 ${\n        isDark ? \'border-slate-800 text-slate-400\' : \'border-slate-100 text-slate-600\'\n      }`}>\n        <span className=\"font-bold flex items-center shrink-0\">\n          INTENT\n          <ArrowRight className=\"h-3 w-3 mx-1 opacity-50 inline\" />\n        </span>\n        <span className={`font-semibold flex items-center shrink-0 ${isDark ? \'text-cyan-400\' : \'text-indigo-600\'}`}>\n          REASONING\n          <ArrowRight className=\"h-3 w-3 mx-1 opacity-50 inline\" />\n        </span>\n        <span className={`font-semibold flex items-center shrink-0 ${isDark ? \'text-purple-400\' : \'text-purple-600\'}`}>\n          MEMORY RECALL\n          <ArrowRight className=\"h-3 w-3 mx-1 opacity-50 inline\" />\n        </span>\n        <span className={`font-semibold flex items-center shrink-0 ${isDark ? \'text-amber-400\' : \'text-amber-600\'}`}>\n          TOOL SEARCH\n          <ArrowRight className=\"h-3 w-3 mx-1 opacity-50 inline\" />\n        </span>\n        <span className={`font-semibold flex items-center shrink-0 ${isDark ? \'text-emerald-400\' : \'text-emerald-600\'}`}>\n          5-FACTOR SCORING\n          <ArrowRight className=\"h-3 w-3 mx-1 opacity-50 inline\" />\n        </span>\n        <span className={`font-bold flex items-center shrink-0 ${isDark ? \'text-blue-400\' : \'text-blue-600\'}`}>\n          EXECUTION PLAN\n        </span>\n      </div>\n    </div>\n  );\n};\n"
    }
