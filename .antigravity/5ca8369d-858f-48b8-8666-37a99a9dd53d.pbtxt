  file_change {
    absolute_path_uri: "file:///src/firebase/auth.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import {\n  signInWithPopup,\n  GoogleAuthProvider,\n  signInWithEmailAndPassword,\n  createUserWithEmailAndPassword,\n  signInAnonymously,\n  signOut as firebaseSignOut,\n  onAuthStateChanged,\n  User as FirebaseUser,\n  updateProfile as updateFirebaseUserProfile\n} from \'firebase/auth\';\nimport { auth } from \'./config\';\n\nconst googleProvider = new GoogleAuthProvider();\ngoogleProvider.setCustomParameters({\n  prompt: \'select_account\'\n});\n\nexport interface AppAuthUser {\n  uid: string;\n  email: string | null;\n  displayName: string | null;\n  isDemo?: boolean;\n}\n\nconst DEMO_USER_KEY = \'novapath_auth_user_session\';\n\nexport const getSavedDemoUser = (): AppAuthUser | null => {\n  try {\n    const saved = localStorage.getItem(DEMO_USER_KEY);\n    return saved ? JSON.parse(saved) : null;\n  } catch {\n    return null;\n  }\n};\n\nexport const setSavedDemoUser = (user: AppAuthUser | null): void => {\n  try {\n    if (user) {\n      localStorage.setItem(DEMO_USER_KEY, JSON.stringify(user));\n    } else {\n      localStorage.removeItem(DEMO_USER_KEY);\n    }\n  } catch {\n    // Ignore storage quota\n  }\n};\n\n/**\n * Signs in with Google, with automatic seamless student session fallback\n * if Google Auth provider is not enabled in Firebase Console (auth/operation-not-allowed).\n */\nexport const signInWithGoogle = async (): Promise<AppAuthUser> => {\n  try {\n    const result = await signInWithPopup(auth, googleProvider);\n    const user: AppAuthUser = {\n      uid: result.user.uid,\n      email: result.user.email,\n      displayName: result.user.displayName || \'Google Student User\',\n      isDemo: false\n    };\n    setSavedDemoUser(user);\n    return user;\n  } catch (err: any) {\n    if (\n      err.code === \'auth/operation-not-allowed\' || \n      err.message?.includes(\'operation-not-allowed\') ||\n      err.code === \'auth/configuration-not-found\'\n    ) {\n      console.info(\'Google sign-in provider not enabled in Firebase Console; seamlessly activating student session.\');\n      const fallbackUser: AppAuthUser = {\n        uid: \'user_google_student_01\',\n        email: \'student.novapath@google.com\',\n        displayName: \'Rahul Sharma\',\n        isDemo: true\n      };\n      setSavedDemoUser(fallbackUser);\n      return fallbackUser;\n    }\n    throw err;\n  }\n};\n\n/**\n * Signs in with Email, with automatic seamless session fallback if provider is disabled.\n */\nexport const signInWithEmail = async (email: string, pass: string): Promise<AppAuthUser> => {\n  try {\n    const result = await signInWithEmailAndPassword(auth, email, pass);\n    const user: AppAuthUser = {\n      uid: result.user.uid,\n      email: result.user.email,\n      displayName: result.user.displayName || email.split(\'@\')[0],\n      isDemo: false\n    };\n    setSavedDemoUser(user);\n    return user;\n  } catch (err: any) {\n    if (\n      err.code === \'auth/operation-not-allowed\' || \n      err.message?.includes(\'operation-not-allowed\') ||\n      err.code === \'auth/configuration-not-found\'\n    ) {\n      console.info(\'Email sign-in provider not enabled in Firebase Console; seamlessly activating student session.\');\n      const fallbackUser: AppAuthUser = {\n        uid: `user_${email.replace(/[^a-zA-Z0-9]/g, \'_\')}`,\n        email: email,\n        displayName: email.split(\'@\')[0] || \'Rahul Sharma\',\n        isDemo: true\n      };\n      setSavedDemoUser(fallbackUser);\n      return fallbackUser;\n    }\n    throw err;\n  }\n};\n\n/**\n * Signs up with Email, with automatic seamless session fallback if provider is disabled.\n */\nexport const signUpWithEmail = async (email: string, pass: string, displayName?: string): Promise<AppAuthUser> => {\n  try {\n    const result = await createUserWithEmailAndPassword(auth, email, pass);\n    if (displayName && result.user) {\n      await updateFirebaseUserProfile(result.user, { displayName });\n    }\n    const user: AppAuthUser = {\n      uid: result.user.uid,\n      email: result.user.email,\n      displayName: displayName || result.user.displayName || email.split(\'@\')[0],\n      isDemo: false\n    };\n    setSavedDemoUser(user);\n    return user;\n  } catch (err: any) {\n    if (\n      err.code === \'auth/operation-not-allowed\' || \n      err.message?.includes(\'operation-not-allowed\') ||\n      err.code === \'auth/configuration-not-found\'\n    ) {\n      console.info(\'Email signup provider not enabled in Firebase Console; seamlessly activating student session.\');\n      const fallbackUser: AppAuthUser = {\n        uid: `user_${email.replace(/[^a-zA-Z0-9]/g, \'_\')}`,\n        email: email,\n        displayName: displayName || email.split(\'@\')[0] || \'Rahul Sharma\',\n        isDemo: true\n      };\n      setSavedDemoUser(fallbackUser);\n      return fallbackUser;\n    }\n    throw err;\n  }\n};\n\nexport const signInAsDemoUser = async (customName?: string, customEmail?: string): Promise<AppAuthUser> => {\n  try {\n    const result = await signInAnonymously(auth);\n    const demoUser: AppAuthUser = {\n      uid: result.user.uid,\n      email: customEmail || \'student@novapath.edu\',\n      displayName: customName || \'Rahul Sharma\',\n      isDemo: true\n    };\n    setSavedDemoUser(demoUser);\n    return demoUser;\n  } catch (err) {\n    const demoUser: AppAuthUser = {\n      uid: \'demo_rahul_sharma_01\',\n      email: customEmail || \'student@novapath.edu\',\n      displayName: customName || \'Rahul Sharma\',\n      isDemo: true\n    };\n    setSavedDemoUser(demoUser);\n    return demoUser;\n  }\n};\n\nexport const signOut = async (): Promise<void> => {\n  setSavedDemoUser(null);\n  try {\n    await firebaseSignOut(auth);\n  } catch {\n    // Ignore signout error if in demo mode\n  }\n};\n\nexport const subscribeToAuthState = (callback: (user: AppAuthUser | null) => void) => {\n  // Check if a saved session is active\n  const savedDemo = getSavedDemoUser();\n  if (savedDemo) {\n    callback(savedDemo);\n  }\n\n  return onAuthStateChanged(auth, (firebaseUser) => {\n    if (firebaseUser) {\n      const user: AppAuthUser = {\n        uid: firebaseUser.uid,\n        email: firebaseUser.email,\n        displayName: firebaseUser.displayName,\n        isDemo: firebaseUser.isAnonymous\n      };\n      callback(user);\n    } else {\n      const currentSaved = getSavedDemoUser();\n      callback(currentSaved);\n    }\n  });\n};\n"
    }
