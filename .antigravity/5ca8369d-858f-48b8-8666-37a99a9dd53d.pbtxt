  file_change {
    absolute_path_uri: "file:///src/components/AgentExecutionPanel.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  CheckCircle2, \n  Circle, \n  Loader2, \n  AlertCircle, \n  ChevronDown, \n  ChevronUp, \n  Terminal, \n  Cpu,\n  Clock,\n  Sparkles\n} from \'lucide-react\';\nimport { AgentStep, AgentRun } from \'../types\';\n\ninterface AgentExecutionPanelProps {\n  run: AgentRun | null;\n  isLoading: boolean;\n}\n\nexport const AgentExecutionPanel: React.FC<AgentExecutionPanelProps> = ({ run, isLoading }) => {\n  const [expandedDetails, setExpandedDetails] = useState<Record<string, boolean>>({});\n\n  const toggleDetails = (stepId: string) => {\n    setExpandedDetails(prev => ({\n      ...prev,\n      [stepId]: !prev[stepId]\n    }));\n  };\n\n  const defaultSteps = [\n    { number: 1, name: \'Understanding your goal & intent\' },\n    { number: 2, name: \'Loading your verified student profile\' },\n    { number: 3, name: \'Retrieving long-term memory & preferences\' },\n    { number: 4, name: \'Formulating multi-criteria search plan\' },\n    { number: 5, name: \'Searching external & curated opportunity sources\' },\n    { number: 6, name: \'Evaluating opportunity-to-profile fit (5-factor score)\' },\n    { number: 7, name: \'Identifying technical skill gaps & learning paths\' },\n    { number: 8, name: \'Ranking high-confidence opportunities\' },\n    { number: 9, name: \'Generating timeline-based action plan\' },\n    { number: 10, name: \'Persisting new preferences to long-term memory\' },\n  ];\n\n  const steps = run?.steps || [];\n  const isCompleted = run?.status === \'COMPLETED\';\n  const isFailed = run?.status === \'FAILED\';\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative\">\n      <div className=\"flex items-center justify-between pb-4 border-b border-slate-800\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400\">\n            <Cpu className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <div className=\"flex items-center space-x-2\">\n              <h3 className=\"text-base font-bold text-white tracking-tight\">\n                NovaPath Agent Orchestrator\n              </h3>\n              {isLoading && (\n                <span className=\"flex items-center space-x-1 text-xs px-2 py-0.5 rounded-full bg-cyan-950 text-cyan-400 border border-cyan-800 animate-pulse\">\n                  <Loader2 className=\"h-3 w-3 animate-spin\" />\n                  <span>Executing Pipeline</span>\n                </span>\n              )}\n              {isCompleted && (\n                <span className=\"flex items-center space-x-1 text-xs px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800\">\n                  <CheckCircle2 className=\"h-3 w-3\" />\n                  <span>Execution Complete</span>\n                </span>\n              )}\n            </div>\n            <p className=\"text-xs text-slate-400\">\n              10-step multi-step reasoning, memory retrieval, tool search, fit evaluation, and execution planning\n            </p>\n          </div>\n        </div>\n\n        {run && (\n          <div className=\"text-right hidden sm:block\">\n            <span className=\"text-[10px] font-mono text-slate-400\">\n              Run ID: {run.id.slice(0, 12)}\n            </span>\n          </div>\n        )}\n      </div>\n\n      {/* Goal & Memory Context Banner */}\n      {run && run.retrieved_preferences && run.retrieved_preferences.length > 0 && (\n        <div className=\"mt-4 p-3 rounded-xl bg-slate-950/80 border border-purple-900/30 text-xs\">\n          <div className=\"flex items-center space-x-1.5 text-purple-300 font-semibold mb-1\">\n            <Sparkles className=\"h-3.5 w-3.5\" />\n            <span>Retrieved Memory In Context:</span>\n          </div>\n          <div className=\"flex flex-wrap gap-1.5 mt-1\">\n            {run.retrieved_preferences.map((pref, idx) => (\n              <span key={idx} className=\"px-2 py-0.5 rounded bg-purple-950/60 border border-purple-800/40 text-purple-200 text-[11px]\">\n                \342\234\223 {pref}\n              </span>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Steps List */}\n      <div className=\"mt-5 space-y-3\">\n        {steps.length > 0 ? (\n          steps.map((step) => {\n            const isStepCompleted = step.status === \'COMPLETED\';\n            const isStepRunning = step.status === \'RUNNING\';\n            const isStepFailed = step.status === \'FAILED\';\n            const hasDetails = step.details && Object.keys(step.details).length > 0;\n            const isExpanded = expandedDetails[step.id];\n\n            return (\n              <div \n                key={step.id}\n                id={`agent-step-${step.step_number}`}\n                className={`rounded-xl border transition-all ${\n                  isStepRunning\n                    ? \'bg-cyan-950/20 border-cyan-500/40 ring-1 ring-cyan-500/20 p-3.5\'\n                    : isStepCompleted\n                    ? \'bg-slate-950/50 border-slate-800/80 p-3\'\n                    : \'bg-slate-950/20 border-slate-900 p-3 opacity-60\'\n                }`}\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-start space-x-3\">\n                    <div className=\"mt-0.5\">\n                      {isStepCompleted && (\n                        <CheckCircle2 className=\"h-4 w-4 text-emerald-400\" />\n                      )}\n                      {isStepRunning && (\n                        <Loader2 className=\"h-4 w-4 text-cyan-400 animate-spin\" />\n                      )}\n                      {isStepFailed && (\n                        <AlertCircle className=\"h-4 w-4 text-rose-400\" />\n                      )}\n                      {step.status === \'PENDING\' && (\n                        <Circle className=\"h-4 w-4 text-slate-600\" />\n                      )}\n                    </div>\n                    <div>\n                      <div className=\"flex items-center space-x-2\">\n                        <span className=\"text-xs font-bold text-slate-400 font-mono\">\n                          Step {step.step_number}\n                        </span>\n                        <h4 className={`text-sm font-semibold ${isStepRunning ? \'text-cyan-300\' : \'text-slate-200\'}`}>\n                          {step.display_title || step.step_name}\n                        </h4>\n                      </div>\n                      <p className=\"text-xs text-slate-400 mt-0.5 leading-relaxed\">\n                        {step.result_summary}\n                      </p>\n                    </div>\n                  </div>\n\n                  {hasDetails && (\n                    <button\n                      onClick={() => toggleDetails(step.id)}\n                      className=\"text-slate-400 hover:text-slate-200 p-1 rounded hover:bg-slate-800 transition-colors text-xs flex items-center space-x-1\"\n                      title=\"Inspect Step Details\"\n                    >\n                      <Terminal className=\"h-3.5 w-3.5\" />\n                      <span className=\"hidden sm:inline text-[10px]\">Data</span>\n                      {isExpanded ? <ChevronUp className=\"h-3 w-3\" /> : <ChevronDown className=\"h-3 w-3\" />}\n                    </button>\n                  )}\n                </div>\n\n                {/* Inspectable JSON Details */}\n                {isExpanded && step.details && (\n                  <div className=\"mt-3 pt-2.5 border-t border-slate-800\">\n                    <div className=\"p-2.5 rounded-lg bg-black/60 border border-slate-800 text-[11px] font-mono text-cyan-300/90 overflow-x-auto max-h-40\">\n                      <pre>{JSON.stringify(step.details, null, 2)}</pre>\n                    </div>\n                  </div>\n                )}\n              </div>\n            );\n          })\n        ) : (\n          /* Placeholder Steps when waiting for first run */\n          defaultSteps.map((s) => (\n            <div \n              key={s.number} \n              className=\"flex items-center justify-between p-3 rounded-xl bg-slate-950/40 border border-slate-900 opacity-60\"\n            >\n              <div className=\"flex items-center space-x-3\">\n                <Circle className=\"h-4 w-4 text-slate-700\" />\n                <span className=\"text-xs font-medium text-slate-400\">\n                  <strong className=\"text-slate-500 mr-1.5\">Step {s.number}</strong>\n                  {s.name}\n                </span>\n              </div>\n              <span className=\"text-[10px] text-slate-600 font-mono\">Ready</span>\n            </div>\n          ))\n        )}\n      </div>\n\n      {run?.summary && (\n        <div className=\"mt-5 p-4 rounded-xl bg-blue-950/30 border border-blue-800/40 text-xs text-blue-200 leading-relaxed\">\n          <strong className=\"text-blue-100 font-semibold block mb-1\">Execution Summary:</strong>\n          {run.summary}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
