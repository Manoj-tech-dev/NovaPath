    instruction: "Redesign GoalInput with theme support and modern styling"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { Send, Sparkles, Compass, Lightbulb } from \'lucide-react\';\n\ninterface GoalInputProps {\n  onPlanPath: (goal: string) => void;\n  isLoading: boolean;\n  activeGoal: string;\n}\n\nexport const GoalInput: React.FC<GoalInputProps> = ({ onPlanPath, isLoading, activeGoal }) => {\n  const [goal, setGoal] = useState(activeGoal || \'I want an AI/ML internship in Hyderabad.\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!goal.trim() || isLoading) return;\n    onPlanPath(goal.trim());\n  };\n\n  const sampleGoals = [\n    \'I want an AI/ML internship in Hyderabad.\',\n    \'Find opportunities for me.\',\n    \'I want a remote Python & Data Science internship.\',\n    \'Looking for ML research opportunities for 2nd year B.Tech.\'\n  ];\n\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative overflow-hidden\">\n      {/* Subtle background glow */}\n      <div className=\"absolute -right-20 -top-20 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute -left-20 -bottom-20 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"relative z-10\">\n        <div className=\"flex items-center space-x-2.5 mb-2\">\n          <div className=\"p-2 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400\">\n            <Compass className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg font-bold text-white tracking-tight\">Set Your Career Goal</h2>\n            <p className=\"text-xs text-slate-400\">\n              NovaPath will decompose your goal, check your profile & memory, search real opportunities, and construct your plan.\n            </p>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"mt-4\">\n          <div className=\"relative\">\n            <input\n              id=\"career-goal-input\"\n              type=\"text\"\n              value={goal}\n              onChange={(e) => setGoal(e.target.value)}\n              disabled={isLoading}\n              placeholder=\"What career goal do you want to achieve? (e.g., I want an AI/ML internship in Hyderabad)\"\n              className=\"w-full bg-slate-950/90 border border-slate-700/80 rounded-xl py-4 pl-4 pr-36 text-slate-100 placeholder-slate-500 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all shadow-inner\"\n            />\n            <button\n              id=\"plan-my-path-btn\"\n              type=\"submit\"\n              disabled={isLoading || !goal.trim()}\n              className=\"absolute right-2 top-2 bottom-2 px-5 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-sm flex items-center space-x-2 transition-all shadow-md shadow-cyan-500/20 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\n            >\n              {isLoading ? (\n                <>\n                  <div className=\"h-4 w-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                  <span>Agent Planning...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"h-4 w-4\" />\n                  <span>Plan My Path</span>\n                </>\n              )}\n            </button>\n          </div>\n        </form>\n\n        {/* Quick Sample Prompts */}\n        <div className=\"mt-4 flex items-center flex-wrap gap-2 text-xs\">\n          <span className=\"text-slate-400 flex items-center font-medium mr-1\">\n            <Lightbulb className=\"h-3.5 w-3.5 text-amber-400 mr-1\" />\n            Quick Prompts:\n          </span>\n          {sampleGoals.map((sample, idx) => (\n            <button\n              key={idx}\n              id={`quick-prompt-${idx}`}\n              type=\"button\"\n              disabled={isLoading}\n              onClick={() => {\n                setGoal(sample);\n                onPlanPath(sample);\n              }}\n              className=\"px-2.5 py-1 rounded-md bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/50 transition-colors cursor-pointer text-xs\"\n            >\n              {sample}\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { Send, Sparkles, Compass, Lightbulb, ArrowRight, Bot } from \'lucide-react\';\n\ninterface GoalInputProps {\n  onPlanPath: (goal: string) => void;\n  isLoading: boolean;\n  activeGoal: string;\n  theme?: \'dark\' | \'light\';\n}\n\nexport const GoalInput: React.FC<GoalInputProps> = ({ \n  onPlanPath, \n  isLoading, \n  activeGoal,\n  theme = \'dark\' \n}) => {\n  const [goal, setGoal] = useState(activeGoal || \'I want an AI/ML internship in Hyderabad.\');\n  const isDark = theme === \'dark\';\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!goal.trim() || isLoading) return;\n    onPlanPath(goal.trim());\n  };\n\n  const sampleGoals = [\n    { label: \'AI/ML Internship in Hyderabad\', text: \'I want an AI/ML internship in Hyderabad.\' },\n    { label: \'Memory Recall: \"Find for me\"\', text: \'Find opportunities for me.\' },\n    { label: \'Remote Python & Data Science\', text: \'I want a remote Python & Data Science internship.\' },\n    { label: \'2nd Year ML Research Fellowships\', text: \'Looking for ML research opportunities for 2nd year B.Tech.\' }\n  ];\n\n  return (\n    <div className={`rounded-3xl p-6 sm:p-7 border relative overflow-hidden transition-all ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 shadow-2xl text-slate-100\'\n        : \'bg-white border-slate-200/90 shadow-xl text-slate-900\'\n    }`}>\n      {/* Subtle Background Accent */}\n      <div className={`absolute top-0 right-0 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-20 ${\n        isDark ? \'bg-cyan-500\' : \'bg-indigo-300\'\n      }`} />\n\n      <div className=\"relative z-10\">\n        <div className=\"flex items-center space-x-3 mb-3\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-indigo-500/10 border-indigo-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Bot className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h2 className=\"text-lg sm:text-xl font-extrabold tracking-tight\">\n              Define Your Opportunity Objective\n            </h2>\n            <p className={`text-xs ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              NovaPath decomposes your intent, loads verified memory, searches real sources, and builds a 10-step execution path.\n            </p>\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"mt-5\">\n          <div className=\"relative flex flex-col sm:flex-row items-stretch gap-2.5\">\n            <div className=\"relative flex-1\">\n              <input\n                id=\"career-goal-input\"\n                type=\"text\"\n                value={goal}\n                onChange={(e) => setGoal(e.target.value)}\n                disabled={isLoading}\n                placeholder=\"What career goal do you want to execute? (e.g. I want an AI/ML internship in Hyderabad)\"\n                className={`w-full rounded-2xl py-4 pl-4 pr-12 text-sm sm:text-base font-medium transition-all focus:outline-none focus:ring-2 border ${\n                  isDark\n                    ? \'bg-slate-950/90 border-slate-700/80 text-white placeholder-slate-500 focus:ring-cyan-500 focus:border-cyan-500 shadow-inner\'\n                    : \'bg-slate-50 border-slate-300 text-slate-900 placeholder-slate-400 focus:ring-indigo-500 focus:border-indigo-500 shadow-inner\'\n                }`}\n              />\n              <div className=\"absolute right-3.5 top-1/2 -translate-y-1/2 hidden sm:block\">\n                <span className={`text-[10px] font-mono px-2 py-0.5 rounded border ${\n                  isDark ? \'bg-slate-900 text-slate-400 border-slate-800\' : \'bg-slate-200 text-slate-600 border-slate-300\'\n                }`}>\n                  \342\206\265 Enter\n                </span>\n              </div>\n            </div>\n\n            <button\n              id=\"plan-my-path-btn\"\n              type=\"submit\"\n              disabled={isLoading || !goal.trim()}\n              className={`px-7 py-4 rounded-2xl font-bold text-sm flex items-center justify-center space-x-2 transition-all cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed ${\n                isDark\n                  ? \'bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white shadow-lg shadow-cyan-500/20\'\n                  : \'bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-500/25\'\n              }`}\n            >\n              {isLoading ? (\n                <>\n                  <div className=\"h-4 w-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                  <span>Agent Planning...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"h-4 w-4\" />\n                  <span>Execute Agent Plan</span>\n                  <ArrowRight className=\"h-4 w-4 ml-1 hidden sm:inline\" />\n                </>\n              )}\n            </button>\n          </div>\n        </form>\n\n        {/* Quick Sample Prompts */}\n        <div className=\"mt-5 flex items-center flex-wrap gap-2 text-xs\">\n          <span className={`flex items-center font-bold mr-1 ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n            <Lightbulb className=\"h-3.5 w-3.5 text-amber-500 mr-1.5\" />\n            Quick Test Prompts:\n          </span>\n          {sampleGoals.map((sample, idx) => (\n            <button\n              key={idx}\n              id={`quick-prompt-${idx}`}\n              type=\"button\"\n              disabled={isLoading}\n              onClick={() => {\n                setGoal(sample.text);\n                onPlanPath(sample.text);\n              }}\n              className={`px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ${\n                isDark\n                  ? \'bg-slate-800/80 hover:bg-slate-800 text-slate-300 hover:text-cyan-300 border-slate-700/70 hover:border-cyan-500/40\'\n                  : \'bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-indigo-700 border-slate-200 hover:border-indigo-300\'\n              }`}\n            >\n              {sample.label}\n            </button>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
      }
      num_matches: 1
    }
  }
}
