      target_content: "import React, { useState } from \'react\';\nimport { CheckSquare, Square, Calendar, Flame, CheckCircle, ArrowRight, Sparkles } from \'lucide-react\';\nimport { ActionPlanItem } from \'../types\';\n\ninterface ActionPlanViewProps {\n  actionPlan: ActionPlanItem[];\n  theme?: \'dark\' | \'light\';\n}\n\nexport const ActionPlanView: React.FC<ActionPlanViewProps> = ({ \n  actionPlan: initialPlan,\n  theme = \'dark\'\n}) => {\n  const [planItems, setPlanItems] = useState<ActionPlanItem[]>(initialPlan);\n  const isDark = theme === \'dark\';\n\n  const toggleComplete = (id: string) => {\n    setPlanItems(prev => prev.map(item => \n      item.id === id ? { ...item, completed: !item.completed } : item\n    ));\n  };\n\n  const completedCount = planItems.filter(i => i.completed).length;\n  const totalCount = planItems.length;\n  const progressPercent = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;\n\n  const groupedByTimeframe: Record<ActionPlanItem[\'timeframe\'], ActionPlanItem[]> = {\n    TODAY: planItems.filter(i => i.timeframe === \'TODAY\'),\n    NEXT_3_DAYS: planItems.filter(i => i.timeframe === \'NEXT_3_DAYS\'),\n    THIS_WEEK: planItems.filter(i => i.timeframe === \'THIS_WEEK\'),\n    NEXT_2_WEEKS: planItems.filter(i => i.timeframe === \'NEXT_2_WEEKS\'),\n  };\n\n  const timeframeLabels: Record<ActionPlanItem[\'timeframe\'], { title: string; subtitle: string; color: string }> = {\n    TODAY: { \n      title: \'TODAY\', \n      subtitle: \'Immediate Kickoff & Profile Optimization\', \n      color: isDark ? \'text-cyan-300 border-cyan-500/40 bg-cyan-950/60\' : \'text-indigo-700 border-indigo-200 bg-indigo-50\' \n    },\n    NEXT_3_DAYS: { \n      title: \'NEXT 3 DAYS\', \n      subtitle: \'Priority Skill-Gap Bridging & Mini-Project\', \n      color: isDark ? \'text-amber-300 border-amber-500/40 bg-amber-950/60\' : \'text-amber-700 border-amber-200 bg-amber-50\' \n    },\n    THIS_WEEK: { \n      title: \'THIS WEEK\', \n      subtitle: \'Direct Application Submissions & Portfolio Review\', \n      color: isDark ? \'text-purple-300 border-purple-500/40 bg-purple-950/60\' : \'text-purple-700 border-purple-200 bg-purple-50\' \n    },\n    NEXT_2_WEEKS: { \n      title: \'NEXT 2 WEEKS\', \n      subtitle: \'Networking, Alumni Outreach & Interview Prep\', \n      color: isDark ? \'text-blue-300 border-blue-500/40 bg-blue-950/60\' : \'text-blue-700 border-blue-200 bg-blue-50\' \n    },\n  };\n\n  return (\n    <div className={`rounded-3xl p-6 sm:p-7 border transition-all ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 shadow-2xl text-slate-100\'\n        : \'bg-white border-slate-200/90 shadow-xl text-slate-900\'\n    }`}>\n      {/* Header */}\n      <div className={`flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b gap-3 ${\n        isDark ? \'border-slate-800\' : \'border-slate-100\'\n      }`}>\n        <div className=\"flex items-center space-x-3.5\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Flame className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-base sm:text-lg font-extrabold tracking-tight\">\n              Action Plan & Execution Timeline\n            </h3>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Chronological 4-stage roadmap decomposed specifically for your targets\n            </p>\n          </div>\n        </div>\n\n        {/* Progress Pill */}\n        <div className={`flex items-center space-x-3 px-4 py-2 rounded-2xl border self-start sm:self-auto ${\n          isDark ? \'bg-slate-950 border-slate-800\' : \'bg-slate-50 border-slate-200\'\n        }`}>\n          <div className=\"text-right\">\n            <span className={`text-[10px] block font-semibold ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Roadmap Progress\n            </span>\n            <span className={`text-xs font-mono font-extrabold ${isDark ? \'text-cyan-300\' : \'text-indigo-700\'}`}>\n              {completedCount} of {totalCount} ({progressPercent}%)\n            </span>\n          </div>\n          <div className={`w-20 rounded-full h-2 overflow-hidden ${isDark ? \'bg-slate-800\' : \'bg-slate-200\'}`}>\n            <div \n              className={`h-2 rounded-full transition-all duration-300 ${\n                isDark ? \'bg-gradient-to-r from-cyan-500 to-indigo-500\' : \'bg-gradient-to-r from-indigo-500 to-cyan-500\'\n              }`}\n              style={{ width: `${progressPercent}%` }}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Plan Timeline Sections */}\n      <div className=\"mt-6 space-y-6\">\n        {(Object.keys(groupedByTimeframe) as ActionPlanItem[\'timeframe\'][]).map((timeframe) => {\n          const items = groupedByTimeframe[timeframe];\n          if (items.length === 0) return null;\n          const meta = timeframeLabels[timeframe];\n\n          return (\n            <div key={timeframe} className=\"space-y-3\">\n              {/* Section Tag */}\n              <div className=\"flex items-center space-x-2.5\">\n                <span className={`text-[11px] font-bold tracking-wider px-3 py-0.5 rounded-full border font-mono ${meta.color}`}>\n                  {meta.title}\n                </span>\n                <span className={`text-xs font-medium hidden sm:inline ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                  \342\200\224 {meta.subtitle}\n                </span>\n              </div>\n\n              {/* Items */}\n              <div className=\"space-y-2\">\n                {items.map((item) => (\n                  <div\n                    key={item.id}\n                    onClick={() => toggleComplete(item.id)}\n                    className={`p-4 rounded-2xl border transition-all cursor-pointer flex items-start space-x-3.5 ${\n                      item.completed\n                        ? isDark\n                          ? \'bg-slate-950/40 border-slate-900 opacity-50\'\n                          : \'bg-slate-50 border-slate-200 opacity-50\'\n                        : isDark\n                          ? \'bg-slate-950/80 border-slate-800/90 hover:border-slate-700\'\n                          : \'bg-slate-50/90 border-slate-200/90 hover:border-slate-300\'\n                    }`}\n                  >\n                    <button className=\"mt-0.5 shrink-0\">\n                      {item.completed ? (\n                        <CheckSquare className=\"h-4 w-4 text-emerald-500\" />\n                      ) : (\n                        <Square className={`h-4 w-4 ${isDark ? \'text-slate-600\' : \'text-slate-400\'}`} />\n                      )}\n                    </button>\n                    <div className=\"flex-1\">\n                      <h4 className={`text-sm font-bold ${\n                        item.completed \n                          ? \'line-through text-slate-400\' \n                          : isDark ? \'text-slate-100\' : \'text-slate-900\'\n                      }`}>\n                        {item.title}\n                      </h4>\n                      <p className={`text-xs mt-1 leading-relaxed ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}>\n                        {item.description}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  CheckSquare, \n  Square, \n  Calendar, \n  Flame, \n  CheckCircle, \n  ArrowRight, \n  Sparkles, \n  Plus, \n  Copy, \n  CheckCheck,\n  Filter,\n  CheckCircle2\n} from \'lucide-react\';\nimport { ActionPlanItem } from \'../types\';\n\ninterface ActionPlanViewProps {\n  actionPlan: ActionPlanItem[];\n  theme?: \'dark\' | \'light\';\n}\n\nexport const ActionPlanView: React.FC<ActionPlanViewProps> = ({ \n  actionPlan: initialPlan,\n  theme = \'dark\'\n}) => {\n  const [planItems, setPlanItems] = useState<ActionPlanItem[]>(initialPlan);\n  const [activeFilter, setActiveFilter] = useState<\'ALL\' | ActionPlanItem[\'timeframe\']>(\'ALL\');\n  const [isAddingTask, setIsAddingTask] = useState(false);\n  const [newTaskTitle, setNewTaskTitle] = useState(\'\');\n  const [newTaskDesc, setNewTaskDesc] = useState(\'\');\n  const [newTaskTimeframe, setNewTaskTimeframe] = useState<ActionPlanItem[\'timeframe\']>(\'TODAY\');\n  const [copied, setCopied] = useState(false);\n\n  const isDark = theme === \'dark\';\n\n  const toggleComplete = (id: string) => {\n    setPlanItems(prev => prev.map(item => \n      item.id === id ? { ...item, completed: !item.completed } : item\n    ));\n  };\n\n  const handleAddTask = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newTaskTitle.trim()) return;\n\n    const newItem: ActionPlanItem = {\n      id: `task-custom-${Date.now()}`,\n      timeframe: newTaskTimeframe,\n      title: newTaskTitle.trim(),\n      description: newTaskDesc.trim() || \'Custom goal action step\',\n      completed: false\n    };\n\n    setPlanItems(prev => [newItem, ...prev]);\n    setNewTaskTitle(\'\');\n    setNewTaskDesc(\'\');\n    setIsAddingTask(false);\n  };\n\n  const handleCopyPlan = () => {\n    const text = planItems.map(item => \n      `[${item.completed ? \'X\' : \' \'}] ${item.timeframe} - ${item.title}: ${item.description}`\n    ).join(\'\\n\');\n\n    navigator.clipboard.writeText(`NovaPath Action Plan:\\n\\n${text}`);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const completedCount = planItems.filter(i => i.completed).length;\n  const totalCount = planItems.length;\n  const progressPercent = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;\n\n  const timeframeLabels: Record<ActionPlanItem[\'timeframe\'], { title: string; subtitle: string; color: string }> = {\n    TODAY: { \n      title: \'TODAY\', \n      subtitle: \'Immediate Kickoff & Profile Optimization\', \n      color: isDark ? \'text-cyan-300 border-cyan-500/40 bg-cyan-950/60\' : \'text-indigo-700 border-indigo-200 bg-indigo-50\' \n    },\n    NEXT_3_DAYS: { \n      title: \'NEXT 3 DAYS\', \n      subtitle: \'Priority Skill-Gap Bridging & Mini-Project\', \n      color: isDark ? \'text-amber-300 border-amber-500/40 bg-amber-950/60\' : \'text-amber-700 border-amber-200 bg-amber-50\' \n    },\n    THIS_WEEK: { \n      title: \'THIS WEEK\', \n      subtitle: \'Direct Application Submissions & Portfolio Review\', \n      color: isDark ? \'text-purple-300 border-purple-500/40 bg-purple-950/60\' : \'text-purple-700 border-purple-200 bg-purple-50\' \n    },\n    NEXT_2_WEEKS: { \n      title: \'NEXT 2 WEEKS\', \n      subtitle: \'Networking, Alumni Outreach & Interview Prep\', \n      color: isDark ? \'text-blue-300 border-blue-500/40 bg-blue-950/60\' : \'text-blue-700 border-blue-200 bg-blue-50\' \n    },\n  };\n\n  const displayedTimeframes = activeFilter === \'ALL\' \n    ? ([\'TODAY\', \'NEXT_3_DAYS\', \'THIS_WEEK\', \'NEXT_2_WEEKS\'] as ActionPlanItem[\'timeframe\'][])\n    : [activeFilter];\n\n  return (\n    <div className={`rounded-3xl p-6 sm:p-7 border transition-all ${\n      isDark\n        ? \'bg-slate-900/90 border-slate-800 shadow-2xl text-slate-100\'\n        : \'bg-white border-slate-200/90 shadow-xl text-slate-900\'\n    }`}>\n      {/* Header */}\n      <div className={`flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b gap-3 ${\n        isDark ? \'border-slate-800\' : \'border-slate-100\'\n      }`}>\n        <div className=\"flex items-center space-x-3.5\">\n          <div className={`p-2.5 rounded-2xl border flex items-center justify-center ${\n            isDark \n              ? \'bg-cyan-500/10 border-cyan-500/30 text-cyan-400\' \n              : \'bg-indigo-50 border-indigo-200 text-indigo-600\'\n          }`}>\n            <Flame className=\"h-5 w-5\" />\n          </div>\n          <div>\n            <h3 className=\"text-base sm:text-lg font-extrabold tracking-tight\">\n              Action Plan & Execution Timeline\n            </h3>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              Chronological 4-stage roadmap decomposed specifically for your targets\n            </p>\n          </div>\n        </div>\n\n        {/* Action Buttons: Add Task & Copy */}\n        <div className=\"flex items-center space-x-2 self-start sm:self-auto\">\n          <button\n            onClick={() => setIsAddingTask(!isAddingTask)}\n            className={`px-3 py-1.5 rounded-xl border text-xs font-bold flex items-center space-x-1.5 transition-all cursor-pointer ${\n              isDark\n                ? \'bg-cyan-950/80 text-cyan-300 border-cyan-700/60 hover:bg-cyan-900\'\n                : \'bg-indigo-50 text-indigo-700 border-indigo-300 hover:bg-indigo-100\'\n            }`}\n          >\n            <Plus className=\"h-3.5 w-3.5\" />\n            <span>Add Step</span>\n          </button>\n\n          <button\n            onClick={handleCopyPlan}\n            className={`px-3 py-1.5 rounded-xl border text-xs font-bold flex items-center space-x-1.5 transition-all cursor-pointer ${\n              copied\n                ? \'bg-emerald-500 text-white border-emerald-500\'\n                : isDark\n                  ? \'bg-slate-800 text-slate-300 border-slate-700 hover:text-white\'\n                  : \'bg-slate-100 text-slate-700 border-slate-200 hover:text-slate-900\'\n            }`}\n            title=\"Copy checklist for Notion/Notes\"\n          >\n            {copied ? <CheckCheck className=\"h-3.5 w-3.5\" /> : <Copy className=\"h-3.5 w-3.5\" />}\n            <span>{copied ? \'Copied!\' : \'Export\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Progress Bar & Milestone feedback */}\n      <div className={`mt-5 p-4 rounded-2xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${\n        isDark ? \'bg-slate-950/60 border-slate-800/80\' : \'bg-slate-50 border-slate-200/80\'\n      }`}>\n        <div className=\"flex items-center space-x-3\">\n          <div className={`p-2 rounded-xl border ${\n            progressPercent === 100 \n              ? \'bg-emerald-500 text-white border-emerald-400\'\n              : isDark ? \'bg-slate-900 text-cyan-400 border-slate-800\' : \'bg-white text-indigo-600 border-slate-200\'\n          }`}>\n            <CheckCircle2 className=\"h-4 w-4\" />\n          </div>\n          <div>\n            <span className=\"text-xs font-bold block\">\n              {progressPercent === 100 \n                ? \'\360\237\216\211 Complete! All action milestones completed!\' \n                : `${completedCount} of ${totalCount} milestones completed (${progressPercent}%)`}\n            </span>\n            <span className={`text-[11px] ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              {progressPercent === 0 \n                ? \'Kickstart your preparation by checking off your first task below!\' \n                : progressPercent < 50 \n                ? \'Great start! Keep following your prioritized sequence.\' \n                : \'Over halfway there! Excellent momentum.\'}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"w-full sm:w-48\">\n          <div className={`w-full rounded-full h-2.5 overflow-hidden ${isDark ? \'bg-slate-800\' : \'bg-slate-200\'}`}>\n            <div \n              className={`h-2.5 rounded-full transition-all duration-300 ${\n                progressPercent === 100\n                  ? \'bg-emerald-500\'\n                  : isDark ? \'bg-gradient-to-r from-cyan-500 to-indigo-500\' : \'bg-gradient-to-r from-indigo-500 to-cyan-500\'\n              }`}\n              style={{ width: `${progressPercent}%` }}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Add Custom Task Form */}\n      {isAddingTask && (\n        <form onSubmit={handleAddTask} className={`mt-4 p-4 rounded-2xl border space-y-3 animate-fade-in ${\n          isDark ? \'bg-slate-950 border-cyan-800/40\' : \'bg-indigo-50/50 border-indigo-200\'\n        }`}>\n          <h4 className=\"text-xs font-bold uppercase tracking-wider text-cyan-400\">\n            Add a Custom Action Item\n          </h4>\n          <input\n            type=\"text\"\n            value={newTaskTitle}\n            onChange={(e) => setNewTaskTitle(e.target.value)}\n            placeholder=\"e.g. Schedule mock interview with alumni mentor...\"\n            className={`w-full rounded-xl p-2.5 text-xs border font-medium focus:outline-none focus:ring-2 ${\n              isDark ? \'bg-slate-900 border-slate-700 text-white focus:ring-cyan-500\' : \'bg-white border-slate-300 text-slate-900 focus:ring-indigo-500\'\n            }`}\n          />\n          <div className=\"flex flex-col sm:flex-row items-center gap-2\">\n            <input\n              type=\"text\"\n              value={newTaskDesc}\n              onChange={(e) => setNewTaskDesc(e.target.value)}\n              placeholder=\"Short description or notes (optional)\"\n              className={`flex-1 w-full rounded-xl p-2.5 text-xs border font-medium focus:outline-none ${\n                isDark ? \'bg-slate-900 border-slate-700 text-slate-200\' : \'bg-white border-slate-300 text-slate-800\'\n              }`}\n            />\n            <select\n              value={newTaskTimeframe}\n              onChange={(e) => setNewTaskTimeframe(e.target.value as ActionPlanItem[\'timeframe\'])}\n              className={`w-full sm:w-auto rounded-xl p-2.5 text-xs border font-medium ${\n                isDark ? \'bg-slate-900 border-slate-700 text-slate-200\' : \'bg-white border-slate-300 text-slate-800\'\n              }`}\n            >\n              <option value=\"TODAY\">Today</option>\n              <option value=\"NEXT_3_DAYS\">Next 3 Days</option>\n              <option value=\"THIS_WEEK\">This Week</option>\n              <option value=\"NEXT_2_WEEKS\">Next 2 Weeks</option>\n            </select>\n            <div className=\"flex items-center space-x-2 w-full sm:w-auto justify-end\">\n              <button\n                type=\"button\"\n                onClick={() => setIsAddingTask(false)}\n                className={`px-3 py-2 rounded-xl text-xs font-semibold border ${\n                  isDark ? \'bg-slate-900 text-slate-400 border-slate-800\' : \'bg-white text-slate-600 border-slate-200\'\n                }`}\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs cursor-pointer shadow-sm\"\n              >\n                Save Step\n              </button>\n            </div>\n          </div>\n        </form>\n      )}\n\n      {/* Timeframe Filter Tabs */}\n      <div className=\"mt-5 flex items-center space-x-1.5 flex-wrap gap-y-1 text-xs\">\n        <button\n          onClick={() => setActiveFilter(\'ALL\')}\n          className={`px-3 py-1.5 rounded-xl font-bold border transition-all cursor-pointer ${\n            activeFilter === \'ALL\'\n              ? isDark ? \'bg-slate-800 text-cyan-300 border-cyan-500/40\' : \'bg-indigo-50 text-indigo-700 border-indigo-300\'\n              : isDark ? \'bg-slate-950/60 text-slate-400 border-slate-800\' : \'bg-slate-100 text-slate-600 border-slate-200\'\n          }`}\n        >\n          All Stages ({planItems.length})\n        </button>\n        {([\'TODAY\', \'NEXT_3_DAYS\', \'THIS_WEEK\', \'NEXT_2_WEEKS\'] as ActionPlanItem[\'timeframe\'][]).map((tf) => (\n          <button\n            key={tf}\n            onClick={() => setActiveFilter(tf)}\n            className={`px-3 py-1.5 rounded-xl font-bold border transition-all cursor-pointer ${\n              activeFilter === tf\n                ? isDark ? \'bg-slate-800 text-cyan-300 border-cyan-500/40\' : \'bg-indigo-50 text-indigo-700 border-indigo-300\'\n                : isDark ? \'bg-slate-950/60 text-slate-400 border-slate-800\' : \'bg-slate-100 text-slate-600 border-slate-200\'\n            }`}\n          >\n            {timeframeLabels[tf].title} ({planItems.filter(i => i.timeframe === tf).length})\n          </button>\n        ))}\n      </div>\n\n      {/* Plan Timeline Sections */}\n      <div className=\"mt-5 space-y-6\">\n        {displayedTimeframes.map((timeframe) => {\n          const items = planItems.filter(i => i.timeframe === timeframe);\n          if (items.length === 0) return null;\n          const meta = timeframeLabels[timeframe];\n\n          return (\n            <div key={timeframe} className=\"space-y-3\">\n              {/* Section Tag */}\n              <div className=\"flex items-center space-x-2.5\">\n                <span className={`text-[11px] font-bold tracking-wider px-3 py-0.5 rounded-full border font-mono ${meta.color}`}>\n                  {meta.title}\n                </span>\n                <span className={`text-xs font-medium hidden sm:inline ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                  \342\200\224 {meta.subtitle}\n                </span>\n              </div>\n\n              {/* Items */}\n              <div className=\"space-y-2\">\n                {items.map((item) => (\n                  <div\n                    key={item.id}\n                    onClick={() => toggleComplete(item.id)}\n                    className={`p-4 rounded-2xl border transition-all cursor-pointer flex items-start space-x-3.5 ${\n                      item.completed\n                        ? isDark\n                          ? \'bg-slate-950/40 border-slate-900 opacity-50\'\n                          : \'bg-slate-50 border-slate-200 opacity-50\'\n                        : isDark\n                          ? \'bg-slate-950/80 border-slate-800/90 hover:border-slate-700\'\n                          : \'bg-slate-50/90 border-slate-200/90 hover:border-slate-300\'\n                    }`}\n                  >\n                    <button className=\"mt-0.5 shrink-0\">\n                      {item.completed ? (\n                        <CheckSquare className=\"h-4 w-4 text-emerald-500\" />\n                      ) : (\n                        <Square className={`h-4 w-4 ${isDark ? \'text-slate-600\' : \'text-slate-400\'}`} />\n                      )}\n                    </button>\n                    <div className=\"flex-1\">\n                      <h4 className={`text-sm font-bold ${\n                        item.completed \n                          ? \'line-through text-slate-400\' \n                          : isDark ? \'text-slate-100\' : \'text-slate-900\'\n                      }`}>\n                        {item.title}\n                      </h4>\n                      <p className={`text-xs mt-1 leading-relaxed ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}>\n                        {item.description}\n                      </p>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};"
    }
